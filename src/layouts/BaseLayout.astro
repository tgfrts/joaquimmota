---
import SeoMetadata from '../components/SeoMetadata.astro';
import SiteIcons from '../components/SiteIcons.astro';
import '../styles/global.css';
import '../styles/hero-video.css';
import '../styles/carousel.css';

interface Props {
  title?: string;
  description?: string;
  socialImage?: string | false;
  richSocial?: boolean;
  social?: boolean;
}

const {
  title = 'Joaquim Mota Consultores',
  description,
  richSocial = false,
  social = true,
  socialImage: suppliedSocialImage,
} = Astro.props;
const socialImage = suppliedSocialImage ?? new URL('/assets/og-jrm.jpg', Astro.site).toString();
---

<!doctype html>
<html lang="pt">
  <head><SiteIcons />
    <slot name="head" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoMetadata />
    {description !== undefined && <meta name="description" content={description} />}
    {social && <>
    <meta property="og:title" content={title} />
    {description !== undefined && <meta property="og:description" content={description} />}
    {socialImage !== false && <meta property="og:image" content={socialImage} />}
    {richSocial && <meta property="og:type" content="website" />}
    {richSocial && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="twitter:title" content={title} />
    {description !== undefined && <meta name="twitter:description" content={description} />}
    {socialImage !== false && <meta name="twitter:image" content={socialImage} />}
    </>}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
