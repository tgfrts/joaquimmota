---
import SiteIcon from './SiteIcon.astro';
import { hasPropertyCharacteristic } from '../lib/property-characteristics';
interface Props { beds?: number | string; baths?: number | string; parking?: number | string; area?: number | string; }
const { beds, baths, parking, area } = Astro.props;
---
<div class="buy-property__facts">{hasPropertyCharacteristic(beds) && <span><SiteIcon name="bed" size={17} />{beds}</span>}{hasPropertyCharacteristic(baths) && <span><SiteIcon name="bath" size={17} />{baths}</span>}{hasPropertyCharacteristic(parking) && <span><SiteIcon name="garage" size={17} />{parking}</span>}{hasPropertyCharacteristic(area) && <span class="buy-property__area"><SiteIcon name="area" size={17} />{area} m²</span>}</div>
