---
import Header from './Header.astro';
import Footer from './Footer.astro';
import CmsImage from './CmsImage.astro';
import sampleContent from '../data/sample-content.json';
import '../styles/blog-index.css';

const records: any[] = Array.isArray(sampleContent) ? sampleContent : (sampleContent as any).documents ?? [];
const articles = records
  .filter((record) => record._type === 'article')
  .sort((a, b) => new Date(b.publishedAt ?? 0).getTime() - new Date(a.publishedAt ?? 0).getTime());
const featured = articles[0];
const sourcePageSize = 6;
---

<Header variant="light" pageNavigation contactHref="/vamos-comecar" />
<main class="blog-index" data-blog-index data-page-size={sourcePageSize} data-article-count={articles.length}>
  {featured && <section class="blog-index__featured" aria-labelledby="blog-featured-title">
    <div class="blog-index__featured-card">
    <div class="blog-index__featured-copy"><p class="blog-index__eyebrow">O nosso último artigo</p><h1 id="blog-featured-title">{featured.title}</h1><a href={`/post/${featured.sourceSlug}`}>Ler mais</a></div>
    <div class="blog-index__featured-image">
      <CmsImage value={featured.thumbnailImage} alt="" loading="eager" />
    </div>
    </div>
  </section>}

  <section class="blog-index__subscribe" aria-labelledby="blog-subscribe-title">
    <div class="blog-index__subscribe-card">
    <div><p class="blog-index__eyebrow">Os últimos artigos no seu email</p><h3 id="blog-subscribe-title">Não perca nenhum artigo!</h3><p>Subscreva a nossa newletter e fique atualizado sobre todas as novidades do mercado imobiliário do Grande Porto.</p></div>
    <div class="blog-index__newsletter-block">
    <p class="blog-index__newsletter-intro">Subscreva a nossa newsletter</p>
    <form data-blog-newsletter>
      <label class="blog-index__visually-hidden" for="blog-newsletter-email">O seu email</label>
      <div class="blog-index__subscribe-controls"><input id="blog-newsletter-email" name="email" type="email" placeholder="O seu email" maxlength="256" required /><button type="submit">SUBSCREVER</button></div>
      <p class="blog-index__privacy">Também detestamos SPAM! Apenas enviamos conteúdo de valor para a sua caixa de correio.</p>
    </form>
    <div class="blog-index__newsletter-success" data-blog-newsletter-success role="status" hidden>Subscrito com sucesso!</div>
    <div class="blog-index__newsletter-error" data-blog-newsletter-error role="alert" hidden>Oops! Alguma coisa correu mal na submissão do formulário</div>
    </div>
    </div>
  </section>

  <section class="blog-index__articles" aria-label="Artigos">
    <div class="blog-index__grid">
      {articles.map((article, index) => <article class="blog-index__card" data-blog-card-page={Math.floor(index / sourcePageSize) + 1}>
        <a class="blog-index__card-image" href="#" aria-label={article.title}><CmsImage value={article.thumbnailImage} alt="" /></a>
        <div class="blog-index__card-copy"><a class="blog-index__card-heading" href="#"><h3>{article.title}</h3>{article.subtitle && <h6>{article.subtitle}</h6>}</a><a class="blog-index__read-more" href={`/post/${article.sourceSlug}`}>Ler mais<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3L11 8L6 13" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></a></div>
      </article>)}
    </div>
    <nav class="blog-index__pagination" aria-label="Paginação de artigos" data-blog-pagination>
      <a href="?51fb55cf_page=1" data-blog-previous aria-label="Página anterior" hidden><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M8 2L4 6L8 10" fill="none" stroke="currentColor" /></svg></a>
      <a href="?51fb55cf_page=2" data-blog-next aria-label="Página seguinte" hidden={articles.length <= sourcePageSize}><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2L8 6L4 10" fill="none" stroke="currentColor" /></svg></a>
    </nav>
  </section>

  <section class="blog-index__closing"><div class="blog-index__closing-card"><div><p class="blog-index__eyebrow">Vamos Conversar</p><h2>Ainda à procura de uma solução para a sua casa?</h2><p>Tenha uma equipa de sucesso ao seu lado.</p><a href="/vamos-comecar">Vamos Começar</a></div><div class="blog-index__closing-portrait"><img src="/assets/closing-jm.png" alt="" loading="lazy" /></div></div></section>
</main>
<Footer />

<script>
  import { submitFormAccepted } from '../scripts/forms-client';

  const root = document.querySelector<HTMLElement>('[data-blog-index]');
  if (root) {
    const params = new URLSearchParams(location.search);
    const rawPage = params.get('51fb55cf_page');
    const requestedPage = rawPage === null ? 1 : /^\d+$/.test(rawPage) ? Number(rawPage) : NaN;
    const totalPages = Math.max(1, Math.ceil(Number(root.dataset.articleCount ?? '0') / Number(root.dataset.pageSize ?? '6')));
    const page = Number.isFinite(requestedPage) ? Math.min(Math.max(requestedPage, 1), totalPages) : 1;
    if (rawPage !== null && rawPage !== String(page)) {
      params.set('51fb55cf_page', String(page));
      const query = params.toString();
      history.replaceState(history.state, '', `${location.pathname}${query ? `?${query}` : ''}${location.hash}`);
    }
    root.dataset.currentPage = String(page);
    const previous = root.querySelector<HTMLAnchorElement>('[data-blog-previous]');
    const next = root.querySelector<HTMLAnchorElement>('[data-blog-next]');
    const hrefForPage = (nextPage: number) => {
      const nextParams = new URLSearchParams(location.search);
      nextParams.set('51fb55cf_page', String(nextPage));
      return `${location.pathname}?${nextParams.toString()}${location.hash}`;
    };
    if (previous) {
      previous.hidden = page <= 1 || totalPages <= 1;
      previous.href = hrefForPage(page - 1);
    }
    if (next) {
      next.hidden = page >= totalPages;
      next.href = hrefForPage(page + 1);
    }
    root.querySelectorAll<HTMLElement>('[data-blog-card-page]').forEach((card) => card.hidden = Number(card.dataset.blogCardPage) !== page);
  }

  document.querySelectorAll<HTMLFormElement>('[data-blog-newsletter]').forEach((form) => form.addEventListener('submit', async (event) => {
    event.preventDefault(); if (!form.reportValidity()) return;
    if (form.dataset.pending === 'true' || form.hidden) return;
    const success = form.parentElement?.querySelector<HTMLElement>('[data-blog-newsletter-success]');
    const error = form.parentElement?.querySelector<HTMLElement>('[data-blog-newsletter-error]');
    const button = form.querySelector<HTMLButtonElement>('button');
    if (!success || !error || !button) return;
    const email = String(new FormData(form).get('email') ?? '').trim();
    const label = button.textContent;
    form.dataset.pending = 'true'; button.disabled = true; button.textContent = 'Please wait...'; error.hidden = true;
    try {
      await submitFormAccepted(form, { formType: 'newsletter', route: '/blog', fields: { email } });
      form.hidden = true; success.hidden = false;
    } catch { error.hidden = false; }
    finally { form.dataset.pending = 'false'; button.disabled = false; button.textContent = label; }
  }));
</script>
