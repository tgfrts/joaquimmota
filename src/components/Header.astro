---
// 'light' denotes the colored-logo variant; its navbar background remains transparent.
import SiteIcon from './SiteIcon.astro';
interface Props { contactHref?: string; desktopContactHref?: string; variant?: 'light' | 'blue'; pageNavigation?: boolean; contactLabel?: string; desktopContactLabel?: string; showBlog?: boolean; }
const { contactHref = '/contacto', desktopContactHref = contactHref, variant = 'light', pageNavigation = false, contactLabel = 'Contacte-nos', desktopContactLabel = contactLabel, showBlog = true } = Astro.props;
const homeLinks = [
  { href: '/', label: 'Início' },
  { href: '/vender', label: 'Vender', mobileOnly: true },
  { href: '/comprar', label: 'Comprar', mobileOnly: true },
  { href: '/imoveis', label: 'Imóveis' },
  { href: '/#testemunhos', label: 'O que dizem os nossos clientes' },
  { href: '/blog', label: 'Blog' },
  { href: '/sobre', label: 'Sobre nós' },
];
const pageLinks = [
  { href: '/', label: 'Início' },
  { href: '/vender', label: 'Vender' },
  { href: '/comprar', label: 'Comprar' },
  { href: '/sobre', label: 'Sobre nós' },
  { href: '/blog', label: 'Blog' },
];
const currentPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/\/$/, '') || '/';
const links = (variant === 'light' || !pageNavigation ? homeLinks : pageLinks)
  .filter(link => (showBlog || link.href !== '/blog') && (variant !== 'light' || link.href !== currentPath));
const navigationId = `site-navigation-${crypto.randomUUID()}`;
---

<header class:list={['site-header', { 'site-header--light': variant === 'light', 'site-header--blue': variant === 'blue' }]} data-header>
  <a class="brand" href="/" aria-label="Joaquim Mota Consultores"><img src={variant === 'light' ? '/assets/logo-color.svg' : '/assets/logo-white.svg'} alt="" /></a>
  <button class="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls={navigationId}><SiteIcon name="menu" size={24} class="menu-toggle__open site-icon" /><SiteIcon name="close" size={24} class="menu-toggle__close site-icon" /></button>
  <nav id={navigationId} aria-label="Navegação principal">
    {links.map((link) => <a class:list={{'nav-desktop-only': link.href === '/#testemunhos', 'nav-mobile-only': 'mobileOnly' in link && link.mobileOnly}} href={link.href}>{link.label}</a>)}
    <a class="nav-mobile-contact" href={contactHref}>{contactLabel}</a>
  </nav>
  <a class:list={['button', 'contact-link', 'button--dark']} href={desktopContactHref}>{desktopContactLabel}</a>
</header>

<script>
  document.querySelectorAll<HTMLElement>('[data-header]').forEach((header) => {
    const button = header.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = header.querySelector<HTMLElement>('nav');
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      button?.setAttribute('aria-expanded', String(open));
      button?.setAttribute('aria-label', open ? 'Fechar menu' : 'Menu');
    };
    button?.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    nav?.addEventListener('click', event => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', event => {
      if (!header.classList.contains('is-open')) return;
      if (event.key === 'Escape') { setOpen(false); button?.focus(); }
      if (event.key === 'Tab') {
        const controls = [button, ...Array.from(nav?.querySelectorAll<HTMLAnchorElement>('a') ?? [])].filter(Boolean) as HTMLElement[];
        const first = controls[0], last = controls.at(-1);
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
      }
    });
    matchMedia('(min-width:992px)').addEventListener('change', event => { if (event.matches) setOpen(false); });
  });
</script>

<style is:global>
  .site-header nav .nav-mobile-only{display:none}
  .nav-mobile-contact { display:none; }
  .interior-secondary-header { position:sticky; top:0; z-index:10; background:linear-gradient(45deg,#20457f,#162b4e); box-shadow:6px 0 20px rgba(0,0,0,.25); }
  /* Owner-approved reduction applies to every navbar variant, including mobile. */
  .site-header .brand img { transform:scale(.9);transform-origin:left center; }
  .site-header:not(:is(.site-header--light, .site-header--blue)) .contact-link {min-height:42px;padding:8px 24px;font:500 16px/24px Roboto,sans-serif;}
  .site-header:is(.site-header--light, .site-header--blue) {
    width: 90vw;
    height: 72px;
    color: #20457f;
    border-bottom: 0;
  }
  :is(.site-header--light, .site-header--blue) .brand img { width: auto; height: 50px; }
  :is(.site-header--light, .site-header--blue) nav {
    position: absolute;
    left: 50%;
    margin: 0;
    transform: translateX(-50%);
    gap: 0;
    font: 500 16px/24px Roboto, sans-serif;
  }
  :is(.site-header--light, .site-header--blue) nav a { padding: 8px 16px; }
  :is(.site-header--light, .site-header--blue) .menu-toggle { color: #20457f; }
  :is(.site-header--light, .site-header--blue) .button--dark {
    min-height: 42px;
    padding: 8px 24px;
    font: 500 16px/24px Roboto, sans-serif;
    background: #db1430;
    border-color: #db1430;
    color: #f4f4f4;
    box-shadow: 4px 4px 20px rgba(0, 0, 0, .25);
  }
  :is(.site-header--light, .site-header--blue) .contact-link { margin-left: auto !important; flex: 0 0 auto; }
  .site-header.site-header--blue { width:90vw; height:72px; border-bottom:0; color:#e4e2df; }
  @media (min-width:992px) {
    .site-header.site-header--blue nav { position:absolute;left:50%;transform:translateX(-50%);margin:0;gap:0;font:500 16px/24px Roboto,sans-serif; }
  }
  @media (max-width:767px) { .site-header.site-header--blue { height:64px; } }
  .site-header--blue .menu-toggle { color: #e4e2df; }
  .site-header--blue .button--dark {
    background: #db1430;
    border-color: #db1430;
    color: #f4f4f4;
  }
  .site-header--blue nav a[href="/"] { color: #9195ba; }
  @media (max-width: 991px) {
    :is(.site-header--light,.site-header--blue) nav .nav-desktop-only{display:none}
    :is(.site-header--light,.site-header--blue) nav .nav-mobile-only{display:block}
    :is(.site-header--light, .site-header--blue) { height:72px; border:0; }
    :is(.site-header--light, .site-header--blue) .brand img { width:51.164px; height:50px; }
    :is(.site-header--light, .site-header--blue) .menu-toggle { display:grid; gap:5px; width:40px; padding:8px; border:0; background:none; margin-left:auto; }
    :is(.site-header--light, .site-header--blue) nav { display:none; }
    :is(.site-header--light, .site-header--blue) .contact-link { display: none; }
    :is(.site-header--light, .site-header--blue) nav { transform: none; left: 0; }
    :is(.site-header--light, .site-header--blue).is-open nav {display:flex;position:absolute;top:72px;left:50%;right:auto;transform:translateX(-50%);width:200px;padding:16px 5vw 40px;background:#fff;box-shadow:0 8px 20px #0002;gap:0;flex-direction:column;align-items:stretch;font:500 18px/27px Roboto,sans-serif;color:#304b7d;text-align:center;}
    :is(.site-header--light, .site-header--blue).is-open nav a {padding:16px 0;}
    :is(.site-header--light, .site-header--blue).is-open .nav-mobile-contact {display:block;}
  }
  @media (max-width:767px) {
    :is(.site-header--light, .site-header--blue) { height:64px; }
    :is(.site-header--light, .site-header--blue).is-open nav { top:64px; }
    :is(.site-header--light, .site-header--blue) .menu-toggle { width:24px; padding:0; }
  }
  @media (max-width:991px) {
    .site-header:not(:is(.site-header--light, .site-header--blue)) {gap:16px;}
    .site-header:not(:is(.site-header--light, .site-header--blue)) .brand img { width:51.164px; height:50px; }
    .site-header:not(:is(.site-header--light, .site-header--blue)) nav { display:none; }
    .site-header:not(:is(.site-header--light, .site-header--blue)) .contact-link { order:1; margin-left:auto; }
    .site-header:not(:is(.site-header--light, .site-header--blue)) .menu-toggle { display:grid;order:2;gap:5px;align-content:center;width:40px;height:48px;padding:8px;margin-left:0;background:none;border:0;color:#f4f4f4; }
    .site-header:not(:is(.site-header--light, .site-header--blue)).is-open nav { display:flex;position:absolute;top:72px;left:50%;right:auto;transform:translateX(-50%);width:max-content;min-width:200px;padding:16px 5vw 40px;background:#fff;box-shadow:0 8px 20px #0002;gap:0;flex-direction:column;align-items:stretch;text-align:center;color:#304b7d; }
    .site-header:not(:is(.site-header--light, .site-header--blue)).is-open nav a {padding:16px 0;font:500 18px/27px Roboto,sans-serif;}
    .site-header:not(:is(.site-header--light, .site-header--blue)).is-open .nav-mobile-contact {display:block;}
  }
  @media (max-width:767px) {
    .site-header:not(:is(.site-header--light, .site-header--blue)) .contact-link {display:none;}
    .site-header:not(:is(.site-header--light, .site-header--blue)) .menu-toggle {margin-left:auto;padding:8px;}
    .site-header:not(:is(.site-header--light, .site-header--blue)).is-open nav {top:64px;}
  }
  @media(max-width:767px){.site-header.site-header--light{height:64px}}
  .site-header.site-header--light .contact-link{background:#20457f;border-color:#20457f;color:#f4f4f4}
  @media(max-width:991px){
    html:has([data-header].is-open),body:has([data-header].is-open){overflow:hidden}
    .interior-hero:has([data-header].is-open){z-index:100;overflow:visible}
    .home-secondary-header:has([data-header].is-open),.interior-secondary-header:has([data-header].is-open){z-index:100}
    [data-header].site-header.is-open{z-index:100}
    [data-header].site-header.is-open nav{position:fixed!important;inset:0!important;transform:none!important;width:100vw!important;height:100dvh!important;max-height:100dvh;margin:0!important;padding:80px 5vw!important;display:flex!important;flex-direction:column;align-items:center!important;justify-content:center;gap:0;background:linear-gradient(45deg,#20457f,#162b4e)!important;color:#f4f4f4!important;overflow-y:auto;box-shadow:none!important;z-index:100}
    [data-header].site-header.is-open nav a{color:#f4f4f4!important;padding:12px 0!important;text-align:center;font:500 18px/27px Roboto,sans-serif!important}
    [data-header].site-header.is-open .menu-toggle{position:fixed;top:20px;right:5vw;width:24px;height:24px;margin:0;padding:0;color:#f4f4f4!important;z-index:101;display:block}
    body:has([data-header].is-open) .whatsapp-widget{visibility:hidden}
  }
  .menu-toggle .menu-toggle__close{display:none}
  .menu-toggle[aria-expanded="true"] .menu-toggle__open{display:none}
  .menu-toggle[aria-expanded="true"] .menu-toggle__close{display:block}
  [data-header].site-header .menu-toggle:before,[data-header].site-header .menu-toggle:after{display:none!important;content:none!important}
  .site-header .menu-toggle .site-icon{width:24px;height:24px;stroke:currentColor}
</style>
