---
interface Props { contactHref?: string; variant?: 'overlay' | 'light'; pageNavigation?: boolean; contactLabel?: string; }
const { contactHref = '/contacto', variant = 'overlay', pageNavigation = false, contactLabel = 'Contacte-nos' } = Astro.props;
const homeLinks = [
  { href: '/vender', label: 'Vender' },
  { href: '/comprar#imoveis', label: 'Imóveis' },
  { href: '/reviews', label: 'O que dizem os nossos clientes' },
  { href: '/blog', label: 'Blog' },
  { href: '/sobre', label: 'Sobre nós' },
];
const pageLinks = [
  { href: '/', label: 'Início' },
  { href: '/vender', label: 'Vender' },
  { href: '/comprar', label: 'Comprar' },
  { href: '/sobre', label: 'Sobre nós' },
  { href: '/blog', label: 'Blog' },
];
const links = pageNavigation ? pageLinks : homeLinks;
---

<header class:list={['site-header', { 'site-header--light': variant === 'light' }]} data-header>
  <a class="brand" href="/" aria-label="Joaquim Mota Consultores"><img src={variant === 'light' ? '/assets/logo-color.svg' : '/assets/logo-white.svg'} alt="" /></a>
  <button class="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-navigation"><span></span></button>
  <nav id="site-navigation" aria-label="Navegação principal">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a class="nav-mobile-contact" href={contactHref}>{contactLabel}</a>
  </nav>
  <a class:list={['button', 'contact-link', variant === 'light' ? 'button--dark' : 'button--light']} href={contactHref}>{contactLabel}</a>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  button?.addEventListener('click', () => {
    const open = header?.classList.toggle('is-open') ?? false;
    button.setAttribute('aria-expanded', String(open));
  });
</script>

<style is:global>
  .nav-mobile-contact { display:none; }
  .site-header--light {
    width: 90vw;
    height: 72px;
    color: #20457f;
    border-bottom: 0;
  }
  .site-header--light .brand img { width: auto; height: 50px; }
  .site-header--light nav {
    position: absolute;
    left: 50%;
    margin: 0;
    transform: translateX(-50%);
    gap: 0;
    font: 500 16px/24px Roboto, sans-serif;
  }
  .site-header--light nav a { padding: 8px 16px; }
  .site-header--light .menu-toggle { color: #20457f; }
  .site-header--light .button--dark {
    min-height: 42px;
    padding: 8px 24px;
    font: 500 16px/24px Roboto, sans-serif;
    background: #db1430;
    border-color: #db1430;
    color: #f4f4f4;
    box-shadow: 4px 4px 20px rgba(0, 0, 0, .25);
  }
  .site-header--light .contact-link { margin-left: auto !important; flex: 0 0 auto; }
  @media (max-width: 640px) {
    .site-header--light { height:64px; border:0; }
    .site-header--light .brand img { width:51.164px; height:50px; }
    .menu-toggle { display:grid; gap:5px; width:24px; padding:0; }
    .menu-toggle span,.menu-toggle:before,.menu-toggle:after { content:"";display:block;width:24px;height:2px;background:currentColor; }
    .site-header--light .contact-link { display: none; }
    .site-header--light nav { transform: none; left: 0; }
    .site-header--light.is-open nav {display:flex;position:absolute;top:64px;left:50%;right:auto;transform:translateX(-50%);width:200px;padding:16px 5vw 40px;background:#fff;box-shadow:0 8px 20px #0002;gap:0;align-items:stretch;font:500 18px/27px Roboto,sans-serif;color:#304b7d;text-align:center;}
    .site-header--light.is-open nav a {padding:16px 0;}
    .site-header--light.is-open .nav-mobile-contact {display:block;}
  }
</style>
