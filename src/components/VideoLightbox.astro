---
import SiteIcon from './SiteIcon.astro';
interface Props { image: string; videoId: string; title: string; }
const {image, videoId, title} = Astro.props;
---
<div data-video-lightbox>
  <button class="video-trigger" type="button" aria-label={`Ver vídeo: ${title}`} data-video-trigger><img src={image} alt="" loading="lazy"/><span aria-hidden="true"><SiteIcon name="play" size={64} class="site-icon" /></span></button>
  <dialog class="video-lightbox" aria-label={title} data-video-dialog><button type="button" aria-label="Fechar vídeo" data-video-close><SiteIcon name="close" size={18} class="site-icon" /></button><iframe data-video-frame data-src={`https://www.youtube.com/embed/${videoId}`} title={title} allowfullscreen></iframe></dialog>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-video-lightbox]').forEach((container) => {
    const dialog = container.querySelector<HTMLDialogElement>('[data-video-dialog]')!;
    const frame = container.querySelector<HTMLIFrameElement>('[data-video-frame]')!;
    container.querySelector('[data-video-trigger]')?.addEventListener('click', () => { frame.src = frame.dataset.src!; dialog.showModal(); });
    container.querySelector('[data-video-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => frame.removeAttribute('src'));
  });
</script>
<style>
 .video-trigger{position:relative;display:block;width:100%;border:0;padding:0;background:none;cursor:pointer}.video-trigger img{width:100%;display:block}.video-trigger span{position:absolute;inset:50% auto auto 50%;width:64px;height:64px;transform:translate(-50%,-50%);color:#f4f4f4}.video-trigger span svg{display:block;width:100%;height:100%}.video-lightbox{box-sizing:border-box;width:100vw;max-width:100vw;height:100vh;max-height:100vh;margin:0;padding:0;border:0;background:transparent;place-items:center;overflow:visible}.video-lightbox[open]{display:grid}.video-lightbox::backdrop{background:rgba(0,0,0,.9)}.video-lightbox iframe{display:block;width:min(940px,90vw);aspect-ratio:940/528;border:0}.video-lightbox button{position:fixed;top:2vh;right:0;width:68px;height:44.1875px;border:0;background:transparent;color:white;font-size:32px;line-height:1;opacity:.8;cursor:pointer;display:grid;place-items:center}.video-lightbox button img{width:18px;height:17px}
 .video-trigger span .site-icon{display:block;width:100%;height:100%;stroke:currentColor}.video-lightbox button .site-icon{width:18px;height:18px;stroke:currentColor}
</style>
