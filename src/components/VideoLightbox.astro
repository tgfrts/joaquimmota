---
interface Props { image: string; videoId: string; title: string; }
const {image, videoId, title} = Astro.props;
---
<div data-video-lightbox>
  <button class="video-trigger" type="button" aria-label={`Ver vídeo: ${title}`} data-video-trigger><img src={image} alt="" loading="lazy"/><span aria-hidden="true">▶</span></button>
  <dialog class="video-lightbox" aria-label={title} data-video-dialog><button type="button" aria-label="Fechar vídeo" data-video-close>×</button><iframe data-video-frame data-src={`https://www.youtube.com/embed/${videoId}`} title={title} allowfullscreen></iframe></dialog>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-video-lightbox]').forEach((container) => {
    const dialog = container.querySelector<HTMLDialogElement>('[data-video-dialog]')!;
    const frame = container.querySelector<HTMLIFrameElement>('[data-video-frame]')!;
    container.querySelector('[data-video-trigger]')?.addEventListener('click', () => { frame.src = frame.dataset.src!; dialog.showModal(); });
    container.querySelector('[data-video-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => frame.removeAttribute('src'));
  });
</script>
<style>
 .video-trigger{position:relative;display:block;width:100%;border:0;padding:0;background:none;cursor:pointer}.video-trigger img{width:100%;display:block}.video-trigger span{position:absolute;inset:50% auto auto 50%;transform:translate(-50%,-50%);font-size:28px;color:white;background:#db1430;border-radius:12px;padding:8px 22px}.video-lightbox{border:0;padding:0;background:#000;width:min(940px,90vw);overflow:visible}.video-lightbox::backdrop{background:#000e}.video-lightbox iframe{display:block;width:100%;aspect-ratio:940/528;border:0}.video-lightbox button{position:absolute;right:0;top:-40px;font-size:32px;color:white;background:none;border:0;cursor:pointer}
</style>
