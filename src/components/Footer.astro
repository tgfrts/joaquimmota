---
interface Props { newsletter?: boolean; facebookHref?: string; }
const {newsletter = true, facebookHref = "https://www.facebook.com/joaquimmotakwJRM"} = Astro.props;
---
<footer class="footer">
  <div class="footer-top shell">
    <div class="footer-contact">
      <a class="brand footer-brand" href="#"><img src="/assets/logo-white.svg" alt="" /></a>
      <div class="footer-details"><p class="footer-motto">SUCESSO E CONTINUIDADE</p><strong>JOAQUIM MOTA CONSULTORES</strong><p>Avenida da República, 690</p><p>4430-190 Vila Nova de Gaia</p><p><a href="tel:+351914257870">+351 914 257 870</a></p><p><a href="mailto:jrmota@kwportugal.pt">jrmota@kwportugal.pt</a></p></div>
      <div class="social"><a href={facebookHref} target="_blank" rel="noreferrer" aria-label="Facebook"><img src="/assets/footer-facebook.svg" alt=""/></a><a href="https://www.instagram.com/joaquimmotakw" target="_blank" rel="noreferrer" aria-label="Instagram"><img src="/assets/footer-instagram.svg" alt=""/></a></div>
      <div class="footer-award"><p class="footer-motto">UM CONSULTOR PREMIADO</p><img src="/assets/premios-2025.webp" alt="" loading="lazy" /></div>
    </div>
    {newsletter && <section class="newsletter" aria-labelledby="newsletter-title">
      <h2 id="newsletter-title">SUBSCREVA A NOSSA NEWSLETTER</h2><p>Receba em primeira mão notícias e novidades sobre o mercado imobiliário</p>
      <form data-footer-newsletter><input name="email" required type="email" maxlength="256" aria-label="O seu email" placeholder="O seu email" /><div class="newsletter-names"><input name="firstName" required type="text" maxlength="256" aria-label="Nome" placeholder="Nome" /><input name="lastName" required type="text" maxlength="256" aria-label="Apelido" placeholder="Apelido" /></div><button type="submit">Subscrever</button><small>*Respeitamos a sua privacidade. Só enviamos conteúdos de interesse relevante para si.</small></form>
      <div aria-live="polite" data-newsletter-success hidden>Obrigado. A sua subscrição foi realizado com sucesso!</div><div aria-live="polite" data-newsletter-error hidden>Oops! Aconteceu algo errado enquanto submetia o formulário..</div>
    </section>}
  </div>
  <div class="footer-bottom shell"><div><span><strong>Joaquim Mota Consultores © </strong>{new Date().getFullYear()}</span><span>Somos Real Estate Med. Imo. Lda. AMI 11829</span></div><div><a href="https://www.kwportugal.pt/politica-de-privacidade" target="_blank" rel="noreferrer">Política de Privacidade</a><span>Made by doop.pt</span></div></div>
</footer>
<script>
  import { submitFormAccepted } from '../scripts/forms-client';
  document.querySelectorAll<HTMLFormElement>('form[data-footer-newsletter]').forEach((form) => form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!button || button.disabled) return;
    if (!form.reportValidity()) return;
    const parent = form.parentElement!;
    const success = parent.querySelector<HTMLElement>('[data-newsletter-success]')!;
    const error = parent.querySelector<HTMLElement>('[data-newsletter-error]')!;
    const data = new FormData(form);
    const fields = {email: String(data.get('email')), firstName: String(data.get('firstName')), lastName: String(data.get('lastName'))};
    error.hidden = true;
    button.disabled = true;
    try { await submitFormAccepted(form, {formType: 'newsletter', route: location.pathname, fields}); form.hidden = true; success.hidden = false; }
    catch { error.hidden = false; }
    finally { button.disabled = false; }
  }));
</script>
<style>
.footer{background:linear-gradient(45deg,#162b4e,#20457f);color:#e4e2df;padding:128px 0 112px}.footer .shell{width:90vw;max-width:none}.footer-top{display:grid;grid-template-columns:1fr 1fr;gap:64px;padding:0}.footer-brand{display:block;width:100px;margin-bottom:32px}.footer-brand img{width:100px;height:50px;margin:0}.footer-details{min-height:180px;margin-bottom:32px} .footer-motto{font:italic 700 16px/24px Roboto,sans-serif;margin:0 0 16px}.footer-details strong{display:block;font-size:14px;line-height:28px;font-weight:700;letter-spacing:0;margin-bottom:0}.footer-details p:not(.footer-motto){font-weight:300;font-size:14px;line-height:28px;margin:0}.footer-details a{text-decoration:underline}.social{display:flex;gap:12px;height:24px;margin:0}.social img{filter:brightness(0) invert(1);display:block;width:24px;height:24px}.footer-award{margin:16px 0}.footer-award .footer-motto{margin:0 0 8px}.footer-award img{display:block;width:202.758px;height:auto;max-width:none}.newsletter{padding-top:0}.newsletter h2{font-size:16px;line-height:24px;font-weight:600;margin:0}.newsletter>p{font-size:16px;line-height:24px;font-weight:300;margin:0 0 16px}.newsletter form{display:block;margin:0 0 12px}.newsletter input{display:block;width:100%;height:44px;min-height:0;font:300 16px/24px Roboto,sans-serif;color:#e4e2df;border:0;border-bottom:1px solid #ffffff60;border-radius:0;padding:8px 12px;background:transparent;margin:0 0 16px}.newsletter-names{display:grid;grid-template-columns:1fr 1fr;gap:16px}.newsletter button{display:block;width:100%;height:42px;border:1px solid #db1430;background:#db1430;color:#f4f4f4;font:500 16px/24px Roboto,sans-serif;padding:8px 20px;box-shadow:4px 4px 20px #0004}.newsletter small{display:block;width:100%;margin-top:16px;font-size:12px;font-weight:300;line-height:18px;color:#e4e2df}.newsletter [hidden]{display:none}.footer-bottom{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid #ffffff60;margin:0 auto;padding:32px 0 0;gap:0;color:#e4e2df;font-size:14px;line-height:21px}.footer-bottom>div{display:flex;flex-direction:column}.footer-bottom>div:last-child{text-align:right}.footer-bottom strong{font-size:14px;letter-spacing:0}.footer-bottom a{text-decoration:underline}@media(max-width:767px){.footer{padding:10vw 0 80px}.footer-top{grid-template-columns:1fr;gap:48px}.newsletter{grid-column:auto}.footer-details{min-height:176px;margin-bottom:24px}.footer-details .footer-motto{margin-bottom:12px}.footer-award img{width:58vw}.newsletter>p{margin-bottom:12px}.newsletter input{margin-bottom:12px}.newsletter-names{grid-template-columns:1fr;gap:0}.newsletter small{margin-top:12px}.footer-bottom{grid-template-columns:1fr;gap:0;margin-top:0;padding-top:24px}.footer-bottom>div{display:contents}.footer-bottom>div:first-child>span:first-child{grid-row:1;margin-top:32px}.footer-bottom>div:last-child>a{grid-row:2}.footer-bottom>div:first-child>span:last-child{grid-row:3;margin-top:32px}.footer-bottom>div:last-child>span{grid-row:4;margin-top:32px}.footer-bottom>div:last-child{text-align:left}}
@media(min-width:768px) and (max-width:991px){.footer{padding:10vw 0 104px}.footer-top{grid-template-columns:1fr;gap:56px}.newsletter{grid-column:auto}}
</style>
