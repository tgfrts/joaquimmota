---
interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  label?: string;
  href: string;
  showButton?: boolean;
}

const { eyebrow = 'Vamos Conversar', heading, body, label = 'Vamos Começar', href, showButton = true } = Astro.props;
---

<section class="closing-cta">
  <div class="closing-cta__card">
    <div class="closing-cta__copy">
      <p class="closing-cta__eyebrow">{eyebrow}</p>
      <h2>{heading}</h2>
      {body && <p class="closing-cta__body">{body}</p>}
      {showButton && <a class="button button--light" href={href}>{label}</a>}
    </div>
    <div class="closing-cta__portrait">
      <img src="/assets/closing-jm.png" alt="" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .closing-cta {
    overflow: hidden;
    padding: 64px 5vw;
    background: var(--paper);
  }

  .closing-cta__card {
    display: grid;
    grid-template-columns: 2fr 1fr;
    align-items: center;
    gap: 64px;
    min-height: 400px;
    padding: 64px;
    color: #f4f4f4;
    background: linear-gradient(45deg, #7b001d, #db1430);
    box-shadow: 8px 8px 20px #00000040;
  }

  .closing-cta__copy {
    position: relative;
    z-index: 1;
    width: auto;
  }

  .closing-cta__eyebrow {
    margin: 0 0 16px;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .closing-cta__copy h2 {
    max-width: 500px;
    margin: 0 0 16px;
    color: #f4f4f4;
    font-size: 40px;
    font-weight: 500;
    line-height: 48px;
  }

  .closing-cta__body {
    margin: 0;
    font-size: 18px;
    font-weight: 300;
    line-height: 27px;
  }

  .closing-cta__copy .button {
    min-height: 50px;
    margin-top: 32px;
    padding: 0 27px;
    color: #20457f;
    border-color: #f4f4f4;
    background: #f4f4f4;
    font-size: 15px;
    font-weight: 600;
    line-height: 23.25px;
    text-transform: none;
  }

  .closing-cta__portrait {
    align-self: stretch;
    min-width: 0;
    margin: -64px;
    overflow: hidden;
    aspect-ratio: 1;
  }

  .closing-cta__portrait img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: none;
    opacity: 1;
    object-fit: contain;
    object-position: right bottom;
    mix-blend-mode: normal;
  }

  @media (max-width: 991px) {
    .closing-cta {
      margin-bottom: -10vw;
      padding: 10vw 5vw 5vw;
    }

    .closing-cta__card {
      grid-template-columns: 1fr;
      gap: 5vw;
      min-height: 0;
      padding: 5vw;
    }

    .closing-cta__copy {
      width: 100%;
    }

    .closing-cta__copy h2 {
      font-size: 44px;
      line-height: 52.8px;
    }

    .closing-cta__portrait {
      justify-self: center;
      align-self: auto;
      width: 115px;
      height: 73.3047px;
      margin: -5vw;
      overflow: hidden;
    }

    .closing-cta__portrait img {
      object-position: center bottom;
    }
  }

  @media (max-width: 767px) {
    .closing-cta {
      margin-bottom: 0;
    }

    .closing-cta__card {
      gap: 5vw;
    }

    .closing-cta__copy h2 {
      margin-bottom: 12px;
      font-size: 36px;
      line-height: 43.2px;
    }

    .closing-cta__eyebrow {
      margin-bottom: 12px;
    }

    .closing-cta__body {
      font-size: 16px;
      line-height: 24px;
    }

    .closing-cta__copy .button {
      margin-top: 24px;
    }

    .closing-cta__portrait {
      width: 43vw;
      height: 38vw;
      margin: -5vw;
    }
  }
</style>
