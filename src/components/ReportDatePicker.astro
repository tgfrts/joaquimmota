---
import '../styles/report-datepicker.css';

interface Props {
  id: string;
  name: string;
  placeholder?: string;
  required?: boolean;
  maxlength?: number;
}

const { id, name, placeholder = 'Escolhe uma data', required = false, maxlength = 256 } = Astro.props;
const popupId = `${id}-datepicker`;
---

<div class="report-datepicker" data-report-date-picker>
  <input
    id={id}
    name={name}
    type="text"
    maxlength={maxlength}
    placeholder={placeholder}
    autocomplete="off"
    required={required}
    data-datepicker-input
  />
  <div class="report-datepicker__popup" id={popupId} data-datepicker-popup hidden></div>
</div>

<script>
  import { initReportDatePickers } from '../scripts/report-datepicker';
  initReportDatePickers();
</script>
