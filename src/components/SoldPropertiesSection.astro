---
import content from '../data/sample-content.json';
import CmsImage from './CmsImage.astro';
import { recordsFromContent, selectRecentSoldProperties } from '../data/cms-content';

const sold = selectRecentSoldProperties(recordsFromContent(content));
const loop = [...sold, ...sold];
---

<section class="sold-properties">
  <p class="sold-properties__eyebrow">UMA VENDA COM SUCESSO</p>
  <h2>Últimos imóveis vendidos</h2>
  <div class="sold-properties__rail" aria-label="Últimos imóveis vendidos">
    <div class="sold-properties__track">
      {loop.map((property, index) => <article class="sold-properties__card" aria-hidden={index >= sold.length ? 'true' : undefined}>
        <div class="sold-properties__image">
          {property.featuredImage && <CmsImage value={property.featuredImage} alt="" loading="lazy" />}
          <span class="sold-properties__image-overlay"></span>
          <span class="sold-properties__banner">VENDIDO</span>
        </div>
        <div class="sold-properties__copy">
          <h3>{property.title}</h3>
          <span class="sold-properties__divider"></span>
          <p class="sold-properties__place"><span>{property.parish}</span>{property.municipality && <span class="sold-properties__municipality">{property.municipality}</span>}</p>
        </div>
      </article>)}
    </div>
  </div>
</section>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('.sold-properties__rail').forEach((rail) => {
    if (reduced.matches) return;
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) rail.classList.add('is-visible');
    });
    observer.observe(rail);
    reduced.addEventListener('change', () => {
      if (reduced.matches) {
        rail.classList.remove('is-visible');
        return;
      }
      const rect = rail.getBoundingClientRect();
      if (rect.top < innerHeight && rect.bottom > 0) rail.classList.add('is-visible');
    });
  });
</script>

<style>
  .sold-properties { width:100%; margin:0; padding:0 0 64px; overflow:hidden; color:#fff; }
  .sold-properties > :is(.sold-properties__eyebrow, h2) { width:90vw; margin-left:auto; margin-right:auto; color:#fff; }
  .sold-properties__eyebrow { margin-top:0; margin-bottom:16px; font-size:16px; font-weight:400; line-height:24px; letter-spacing:0; }
  .sold-properties h2 { margin-top:0; margin-bottom:64px; font-size:40px; font-weight:500; line-height:48px; text-align:left; }
  .sold-properties__rail { width:100vw; overflow:hidden; padding:0; }
  .sold-properties__track { display:flex; gap:5vw; width:max-content; animation:sold-properties-loop 48s linear infinite; animation-play-state:paused; }
  .sold-properties__rail.is-visible .sold-properties__track { animation-play-state:running; }
  .sold-properties__rail:hover .sold-properties__track, .sold-properties__rail:focus-within .sold-properties__track { animation-play-state:paused; }
  .sold-properties__card { position:relative; flex:0 0 25vw; width:25vw; aspect-ratio:2 / 3; overflow:hidden; background:#162b4e; }
  .sold-properties__image { position:absolute; inset:0; overflow:hidden; }
  .sold-properties__image :global(img) { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .sold-properties__image-overlay { position:absolute; inset:0; background:#00093426; }
  .sold-properties__banner { position:absolute; inset:0; display:block; background:url('/assets/prelisting-sold-banner.webp') center/contain no-repeat; color:transparent; font-size:0; }
  .sold-properties__copy { position:absolute; z-index:2; inset:auto 0 0; padding:2vw; color:#fff; }
  .sold-properties__copy h3 { margin:0; font-size:24px; font-weight:500; line-height:31.2px; letter-spacing:-.48px; }
  .sold-properties__divider { display:block; width:100%; height:1px; margin:1vw 0; background:#e4e2df; }
  .sold-properties__place { display:flex; flex-direction:column; gap:0; margin:0; color:#fff; font-size:17.6px; font-weight:500; line-height:24.64px; letter-spacing:-.02em; }
  @keyframes sold-properties-loop { to { transform:translateX(-150vw); } }
  @keyframes sold-properties-loop-mobile { to { transform:translateX(-400vw); } }
  @media (min-width:768px) { .sold-properties__municipality { order:-1; } }
  @media (max-width:991px) {
    .sold-properties { padding:5vw 0; }
    .sold-properties h2 { margin-bottom:5vw; font-size:44px; line-height:52.8px; }
    .sold-properties__track { animation-duration:25s; }
  }
  @media (max-width:767px) {
    .sold-properties { padding:5vw 0; }
    .sold-properties__eyebrow { margin-bottom:12px; }
    .sold-properties h2 { margin-bottom:20px; font-size:36px; line-height:43.2px; }
    .sold-properties__track { gap:5vw; animation-name:sold-properties-loop-mobile; animation-duration:20s; }
    .sold-properties__card { flex-basis:75vw; width:75vw; }
    .sold-properties__copy { padding:5vw; }
    .sold-properties__copy h3 { font-size:24px; line-height:1.4; }
    .sold-properties__place { font-size:18px; line-height:1.4; }
  }
  @media (prefers-reduced-motion:reduce) { .sold-properties__track { animation:none; } }
</style>
