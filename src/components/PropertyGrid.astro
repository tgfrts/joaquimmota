---
import PropertyCard from './PropertyCard.astro';
import { availableProperties } from '../data/available-properties';
interface Props { limit?: number; offset?: number; }
const { limit, offset = 0 } = Astro.props;
const properties = availableProperties.slice(offset, limit === undefined ? undefined : offset + limit);
---
<div class="buy-properties__grid">{properties.map(property => <PropertyCard property={property} />)}</div>
