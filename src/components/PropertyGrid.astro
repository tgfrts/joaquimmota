---
import CmsImage from './CmsImage.astro';
import { availableProperties } from '../data/available-properties';
interface Props { limit?: number; }
const { limit } = Astro.props;
const properties = limit ? availableProperties.slice(0, limit) : availableProperties;
---
<div class="buy-properties__grid">{properties.map(property => <a class="buy-property" data-source-id={property.legacyId} href={`/imoveis/${property.slug}`}><div class="buy-property__image">{property.cms?.featuredImage ? <CmsImage value={property.cms.featuredImage} alt="" loading="lazy" /> : <img src={property.image} width={property.imageWidth} height={property.imageHeight} alt="" loading="lazy" />}<span class:list={{'buy-property__badge--reserved': property.label === 'Reservado', 'buy-property__badge--new-price': property.label === 'Novo Preço'}}>{property.label}</span></div><div class="buy-property__copy"><h3>{property.title}</h3>{property.priceOnRequest ? <p class="buy-property__price">Preço sob consulta</p> : <p class="buy-property__price"><b>€</b>{property.price}</p>}<p class="buy-property__place"><img src="/assets/property-address.svg" alt="" /><span>{property.municipality}</span><span>{property.parish}</span></p><p class="buy-property__reference">{property.reference}</p><hr /><div class="buy-property__facts"><span><img src="/assets/property-bed.svg" alt="" />{property.beds}</span><span><img src="/assets/property-bath.svg" alt="" />{property.baths}</span><span><img src="/assets/property-garage.svg" alt="" />{property.parking}</span><span class="buy-property__area"><img src="/assets/property-area.svg" alt="" />{property.area} m2 - Área Bruta</span></div></div></a>)}</div>
