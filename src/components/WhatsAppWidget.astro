  <script>
    const widget = document.querySelector<HTMLElement>('[data-whatsapp-widget]');
    const launcher = widget?.querySelector<HTMLButtonElement>('.whatsapp-launcher');
    const popup = widget?.querySelector<HTMLElement>('.whatsapp-popup');
    const close = widget?.querySelector<HTMLButtonElement>('.whatsapp-popup__close');
    const setPopup = (open: boolean) => { if (popup) popup.hidden = !open; launcher?.setAttribute('aria-expanded', String(open)); };
