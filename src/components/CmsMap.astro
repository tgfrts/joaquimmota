---
import { mediaSource } from '../lib/media-source';
interface Props { embed?: string; title: string; loading?: 'lazy' | 'eager'; }
const { embed, title, loading = 'lazy' } = Astro.props;
const source = mediaSource(embed);
---

{source && <iframe class="cms-map" title={title} src={source} loading={loading} referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>}
