---
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import BaseLayout from '../layouts/BaseLayout.astro';import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';import '../styles/contact.css';
const map='https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1146.6376679283198!2d-8.607715179546624!3d41.13249371607835!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd2464cc2dc5b4cf%3A0x4a7177241133531b!2sKW%20Somos%20Real%20Estate!5e0!3m2!1spt-PT!2spt!4v1657070299232!5m2!1spt-PT!2spt';
---
<BaseLayout title="Contacto"><Header variant="light" pageNavigation contactHref="/contacto" desktopContactHref="/vamos-comecar" desktopContactLabel="Vamos Começar"/><main><section class="contact-hero"><strong>Joaquim Mota Consultores Imobiliários</strong><h1>Somos especialistas no mercado do Grande Porto</h1><a class="contact-button" href="#map">Onde estamos</a><div class="contact-hero-image"><img src="/assets/contact-hero.png" alt="" loading="eager" /></div></section><section class="contact-details"><div class="contact-grid"><article><div class="contact-detail-copy"><h6>Email</h6><a href="mailto:jrmota@kwportugal.pt">jrmota@kwportugal.pt</a></div><img class="contact-detail-icon" src="/assets/contact-email.svg" alt="" loading="lazy"/></article><article><div class="contact-detail-copy"><h6>Telefone</h6><a href="tel:+351914257870">+351 914 257 870</a></div><img class="contact-detail-icon" src="/assets/contact-phone.svg" alt="" loading="lazy"/></article><article><div class="contact-detail-copy"><h6>Endereço</h6><p>Avenida da República 690<br/>4430-190 Vila Nova de Gaia</p></div><img class="contact-detail-icon" src="/assets/contact-pin.svg" alt="" loading="lazy"/></article></div><iframe id="map" class="contact-map" src={map} loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="KW Somos Real Estate"></iframe></section><section class="contact-cta"><div class="contact-cta__card" data-contact-cta-motion><div><p>Vamos Conversar</p><h2>Ainda à espera do feedback do "seu" consultor?</h2><p>Nós não deixamos niguém à espera.</p><a class="contact-button" href="/vamos-comecar">Vamos Começar</a></div><div class="contact-cta__portrait"><img src="/assets/contact-portrait.png" alt="" loading="lazy" /></div></div></section></main><Footer/><WhatsAppWidget/></BaseLayout>

<script>
  import { bindSourceScrollMotion, interpolate } from '../scripts/source-scroll-motion';
  const cta = document.querySelector<HTMLElement>('[data-contact-cta-motion]');
  if (cta) bindSourceScrollMotion(cta, (progress, reduced) => {
    cta.style.opacity = reduced ? '1' : String(interpolate(progress, [[0, 0], [.35, 1], [1, 1]]));
    cta.style.transform = reduced ? 'none' : `scale(${interpolate(progress, [[0, 1.25], [.35, 1], [1, 1]])})`;
  });
</script>
