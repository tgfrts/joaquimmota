---
import VideoLightbox from '../components/VideoLightbox.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import BaseLayout from '../layouts/BaseLayout.astro';import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';import '../styles/about.css';
const testimonials=[{"name": "Gisela Almeida", "quote": "Pela segunda vez, recorri ao Sr. Joaquim, para ajuda na venda e compra de casa. Rapidez, disponibilidade e profissionalismo! Bastante prestável e confiável! Desejo continuação de muito sucesso!"}, {"name": "António Marques", "quote": "Boa experiência."}, {"name": "Ivone Baldaia", "quote": "Consultoria imobiliária de excelência, apoio em todo o processo de compra e pós compra. Obrigada Sr. Mota pelo profissionalismo, seriedade e disponibilidade."}, {"name": "Joaquim Ferreira", "quote": "Muito bom resultados 100%. Excelente."}, {"name": "Isidro Guedes", "quote": "Grande profissional, rigor, empenho, dedicação ao negócio!\nMuito obrigado."}, {"name": "Bruno Vanessa", "quote": "Excelente profissional... recomendo."}, {"name": "Ivo Durães", "quote": "Profissional, dedicado e honesto. Obrigado pela ajuda na compra da casa."}, {"name": "Carlos Dourado", "quote": "Registo, o profissionalismo do Sr. Joaquim Mota, durante o período que ambos partilhamos, o que permitiu a consumação do contrato relativo ao apartamento, sito em Macedo de Cavaleiros."}, {"name": "sonia teixeira", "quote": "Muita eficácia e profissionalismo... Recomendo."}, {"name": "paulinhodefontes youtube", "quote": "Foi uma venda rápida e bem sucedida. Pessoal simpático, profissional e dedicado."}];
---
<BaseLayout title="Sobre"><Header variant="light" pageNavigation/><main>
<section class="about-hero"><p class="about-eyebrow">Joaquim Mota Consultores Imobiliários</p><h1>Não somos os típicos consultores imobiliários</h1><p class="about-hero-copy">Temos orgulho em lhe poder proporcionar um serviço de excelência. Não estamos aqui apenas para "abrir a porta" da sua casa.</p><a class="about-button" href="/reviews">As nossas avaliações</a><div class="about-hero-image"><img src="/assets/about-hero.png" alt="" loading="eager"/></div></section>
<section class="about-section about-grid"><div><p class="about-eyebrow">Entrevista</p><h2>Conheça o meu percurso</h2><p>Nesta entrevista falamos um pouco sobre quem sou e o meu percurso profissional até virar um consultor imobiliário de sucesso.</p></div><VideoLightbox image="/assets/about-video-0.jpg" videoId="GA8Iw5rMdyw" title="Conheça o meu percurso"/></section>
<section class="about-interview"><p class="about-eyebrow">SOmos PErfil</p><h2>Leia a entrevista completa</h2><p>Conheça nesta entrevista um pouco mais sobre quem sou e o meu percurso profissional até virar um consultor imobiliário de sucesso.</p><a class="about-button" href="https://drive.google.com/file/d/1yReWQExXBI34cqCxArzpSLjCcMUDXJIM/view" target="_blank" rel="noopener">LER ENTREVISTA</a></section>
<section class="about-section about-grid"><div><p class="about-eyebrow">Conheça o nosso CEO</p><h2>Olá, eu sou o Joaquim Mota</h2><p>Gosto de ultrapassar as adversidades encontrando uma solução em qualquer problema. Considero-me uma pessoa focada em objetivos e na prestação de um bom serviço aos meus clientes, pois a minha maior alegria é quando um cliente fica satisfeito com o meu trabalho.</p></div><VideoLightbox image="/assets/about-video-1.jpg" videoId="YSc7-Sk6zlQ" title="Olá, eu sou o Joaquim Mota"/></section>
<section class="about-testimonials"><p class="about-eyebrow">O que dizem os nossos clientes</p><h2>Os nossos clientes são os nossos maiores fãs.</h2><a href="/reviews">Leia as nossas avaliações</a><div>{testimonials.map(({name, quote})=><figure><div aria-label="5 estrelas">★★★★★</div><blockquote>{quote}</blockquote><figcaption>{name}</figcaption></figure>)}</div></section>
<section class="about-cta"><p class="about-eyebrow">Vamos Conversar</p><h2>Ainda à espera do feedback do "seu" consultor?</h2><p>Nós não deixamos niguém à espera.</p><a class="about-button" href="/vamos-comecar">Vamos Começar</a></section></main><Footer/><WhatsAppWidget/></BaseLayout>
