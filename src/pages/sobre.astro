---
import TestimonialsSection from '../components/TestimonialsSection.astro';
import VideoLightbox from '../components/VideoLightbox.astro';
import ClosingCta from '../components/ClosingCta.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import InteriorHero from '../components/InteriorHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/about.css';
import sampleData from '../data/sample-content.json';

const testimonials = [
  { name: 'Gisela Almeida', quote: 'Pela segunda vez, recorri ao Sr. Joaquim, para ajuda na venda e compra de casa. Rapidez, disponibilidade e profissionalismo! Bastante prestável e confiável! Desejo continuação de muito sucesso!' },
  { name: 'António Marques', quote: 'Boa experiência.' },
  { name: 'Ivone Baldaia', quote: 'Consultoria imobiliária de excelência, apoio em todo o processo de compra e pós compra. Obrigada Sr. Mota pelo profissionalismo, seriedade e disponibilidade.' },
  { name: 'Joaquim Ferreira', quote: 'Muito bom resultados 100%. Excelente.' },
  { name: 'Isidro Guedes', quote: 'Grande profissional, rigor, empenho, dedicação ao negócio!\nMuito obrigado.' },
  { name: 'Bruno Vanessa', quote: 'Excelente profissional... recomendo.' },
  { name: 'Ivo Durães', quote: 'Profissional, dedicado e honesto. Obrigado pela ajuda na compra da casa.' },
  { name: 'Carlos Dourado', quote: 'Registo, o profissionalismo do Sr. Joaquim Mota, durante o período que ambos partilhamos, o que permitiu a consumação do contrato relativo ao apartamento, sito em Macedo de Cavaleiros.' },
  { name: 'sonia teixeira', quote: 'Muita eficácia e profissionalismo... Recomendo.' },
  { name: 'paulinhodefontes youtube', quote: 'Foi uma venda rápida e bem sucedida. Pessoal simpático, profissional e dedicado.' },
];
const documents: any[] = Array.isArray(sampleData) ? sampleData : (sampleData as any).documents ?? [];
const ivoCms = documents.find((document) => document._type === 'testimonial' && document.clientName === 'Ivo Durães');
const ivoPortrait = ivoCms?.portrait ?? ivoCms?.image;
---

<BaseLayout title="Sobre">
  <Header variant="light" pageNavigation />
  <main class="about-page">
    <InteriorHero eyebrow="Joaquim Mota Consultores Imobiliários" heading="Não somos os típicos consultores imobiliários" body={'Temos orgulho em lhe poder proporcionar um serviço de excelência. Não estamos aqui apenas para "abrir a porta" da sua casa.'} image="/assets/about-hero.png" label="As nossas avaliações" href="#testemunhos" />
    <div class="interior-secondary-header"><Header variant="blue" pageNavigation showBlog={false} contactHref="/vamos-comecar" contactLabel="Vamos começar" /></div>
    <section class="about-profile about-profile--journey"><div class="about-profile__card"><div class="about-profile__copy"><p class="about-kicker">Entrevista</p><h2>Conheça o meu percurso</h2><p>Nesta entrevista falamos um pouco sobre quem sou e o meu percurso profissional até virar um consultor imobiliário de sucesso.</p></div><VideoLightbox image="/assets/about-video-0.jpg" videoId="GA8Iw5rMdyw" title="Conheça o meu percurso" /></div></section>
    <section class="about-profile-cta"><div class="about-profile-cta__card"><div><p class="about-kicker">SOmos PErfil</p><h2>Leia a entrevista completa</h2><p>Conheça nesta entrevista um pouco mais sobre quem sou e o meu percurso profissional até virar um consultor imobiliário de sucesso.</p><a class="about-button" href="https://drive.google.com/file/d/1yReWQExXBI34cqCxArzpSLjCcMUDXJIM/view" target="_blank" rel="noopener">LER ENTREVISTA</a></div></div></section>
    <section class="about-profile"><div class="about-profile__card"><div class="about-profile__copy"><p class="about-kicker">Conheça o nosso CEO</p><h2>Olá, eu sou o Joaquim Mota</h2><p>Gosto de ultrapassar as adversidades encontrando uma solução em qualquer problema. Considero-me uma pessoa focada em objetivos e na prestação de um bom serviço aos meus clientes, pois a minha maior alegria é quando um cliente fica satisfeito com o meu trabalho.</p></div><VideoLightbox image="/assets/about-video-1.jpg" videoId="YSc7-Sk6zlQ" title="Olá, eu sou o Joaquim Mota" /></div></section>
    <TestimonialsSection items={testimonials.map(({name,quote},index) => ({clientName:name,quote,portrait:index === 6 ? ivoPortrait ?? "/assets/about-ivo-duraes.webp" : undefined}))} />
    <ClosingCta heading={'Ainda à espera do feedback do "seu" consultor?'} body="Nós não deixamos niguém à espera." href="/vamos-comecar" />
  </main>
  <Footer /><WhatsAppWidget />
</BaseLayout>
