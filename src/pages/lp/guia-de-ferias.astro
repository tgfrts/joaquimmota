---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CampaignLeadForm from '../../components/CampaignLeadForm.astro';
import '../../styles/campaigns.css';
---
<BaseLayout title="Guia de Férias" description="As férias estão quase aí. Mas antes da partida há sempre a dúvida se algo fica por fazer. Preparei um guia rápido para acabar com essas dúvidas antes de partir. Coisas simples que, se fizer agora, garantem que as únicas surpresas nas férias serão boas." socialImage={false} richSocial><main class="campaign-page campaign-page--holiday"><div class="campaign-page__image" style="background-image:url('/assets/campaign-ferias.webp')"></div><section class="campaign-page__panel"><a href="/"><img class="campaign-page__logo" src="/assets/logo-color.svg" alt="" /></a><h5>Receba o seu guia gratuito para umas férias tranquilas.</h5><CampaignLeadForm route="/lp/guia-de-ferias" submitLabel="Enviar" downloadUrl="https://drive.google.com/file/d/1Cy4G9-0rLHbO8CG0AlEbvaxPhql1yl4L/view?usp=sharing" showReferralQuestions /></section></main></BaseLayout>

<style is:global>.campaign-page--holiday .campaign-form input:not([type=checkbox]),.campaign-page--holiday .campaign-form select{padding:10px 0;color:#333}.campaign-page--holiday .campaign-form__consent{margin-bottom:15px}.campaign-page--holiday .campaign-form button{background:#db1430;border:1px solid #db1430;color:#e4e2df}</style>
