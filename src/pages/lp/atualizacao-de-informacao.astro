---
import '../../styles/information-update.css';
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content="Atualização de Informação" /><meta name="twitter:title" content="Atualização de Informação" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>Atualização de Informação</title>
  </head>
  <body>
    <main class="information-update">
      <div class="information-update__image" aria-hidden="true"></div>
      <section class="information-update__panel">
        <a class="information-update__logo" href="/" aria-label="Joaquim Mota — página inicial"><img src="/assets/logo-color.svg" alt="" width="100" height="49" /></a>
        <h5>Para atualizar as suas informações, preencha o formulário.</h5>
        <form data-information-update data-route="/lp/atualizacao-de-informacao">
          <div class="information-update__names"><input name="firstName" maxlength="256" autocomplete="given-name" placeholder="Nome" required /><input name="lastName" maxlength="256" autocomplete="family-name" placeholder="Apelido" required /></div>
          <input name="email" type="email" maxlength="256" autocomplete="email" placeholder="O seu email" required />
          <input name="phone" type="tel" maxlength="256" autocomplete="tel" placeholder="Telefone" required />
          <input name="street" maxlength="256" autocomplete="street-address" placeholder="A sua morada" required />
          <input name="postalCode" maxlength="256" autocomplete="postal-code" placeholder="Código Postal" required />
          <input name="county" maxlength="256" autocomplete="address-level2" placeholder="Concelho" required />
          <label class="information-update__consent"><input name="consent" type="checkbox" required checked /><span>Aceito que os meus dados sejam utilizados para envio de informações comerciais e marketing, por Joaquim Mota Consultores Imobiliários.</span></label>
          <button type="submit" data-wait="Por favor aguarde...">Enviar</button>
        </form>
        <p class="information-update__status" data-information-status role="status" aria-live="polite" hidden></p>
      </section>
    </main>
  </body>
</html>
<script>
  import { submitFormAccepted } from '../../scripts/forms-client';
  document.querySelectorAll<HTMLFormElement>('[data-information-update]').forEach((form) => form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = form.parentElement?.querySelector<HTMLElement>('[data-information-status]');
    if (!button || !status || button.disabled) return;
    button.disabled = true;
    button.textContent = button.dataset.wait ?? button.textContent;
    status.hidden = false;
    status.textContent = '';
    const message = [`A sua morada: ${data.get('street')}`, `Código Postal: ${data.get('postalCode')}`, `Concelho: ${data.get('county')}`].join('\n');
    try {
      await submitFormAccepted(form, { formType: 'leadMagnet', route: form.dataset.route ?? '', fields: { name: `${data.get('firstName')} ${data.get('lastName')}`.trim(), email: data.get('email'), phone: data.get('phone'), message } });
      form.hidden = true;
      status.textContent = 'Obrigado! O seu formulário foi enviado com sucesso.';
    } catch {
      status.textContent = 'Oops! Aconteceu algo de errado enquanto submetia o seu formulário.';
      button.disabled = false;
      button.textContent = 'Enviar';
    }
  }));
</script>
