---
import CmsImage from '../../components/CmsImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import sampleContent from '../../data/sample-content.json';
import testimonialOrder from '../../data/prelisting-testimonial-order.json';
import testimonialSource from '../../data/prelisting-testimonial-source.json';
import '../../styles/prelisting.css';
export function getStaticPaths() { const sampleRecords: any[] = Array.isArray(sampleContent) ? sampleContent : (sampleContent as any).documents ?? []; return sampleRecords.filter((record) => record._type === 'preListing').map((record) => ({ params: { slug: record.slug?.current ?? record.sourceSlug }, props: { record } })); }
const { record } = Astro.props;
const heroImageRef = record.heroImage?.asset?._ref;
const heroSocialImage = typeof heroImageRef === 'string' ? (() => { const [, id, dimensions, format] = heroImageRef.match(/^image-(.+)-(\d+x\d+)-([a-z0-9]+)$/) ?? []; return id && dimensions && format ? `https://cdn.sanity.io/images/kaq1vd9b/production/${id}-${dimensions}.${format}` : undefined; })() : undefined;
const sampleRecords: any[] = Array.isArray(sampleContent) ? sampleContent : (sampleContent as any).documents ?? [];
const reasons = [
  ['/assets/prelisting-reason-1.svg', 'Conhecimento profundo do mercado local', 'Trabalho nesta zona há mais de 10 anos. Conheço bem o tipo de comprador que procura casa aqui e como posicionar o seu imóvel para gerar interesse e propostas.'],
  ['/assets/prelisting-reason-2.svg', 'Estratégia de preço baseada no mercado', 'Utilizo análises comparativas e dados de mercado para definir um posicionamento que maximize o interesse dos compradores sem comprometer o valor do imóvel.'],
  ['/assets/prelisting-reason-3.svg', 'Apresentação profissional do imóvel', 'Fotografia profissional, apresentação cuidada e presença nos principais canais ajudam a garantir que o seu imóvel se destaca desde o primeiro momento.'],
  ['/assets/prelisting-reason-4.svg', 'Acompanhamento claro do início ao fim', 'Durante todo o processo terá um único ponto de contacto, com comunicação clara e acompanhamento até à escritura.'],
];
const process = [
  ['Reunião inicial', 'Visitamos o imóvel e conversamos sobre os seus objetivos, prazos e expectativas. É neste momento que começo a perceber qual a melhor estratégia para a venda.'],
  ['Análise e definição da estratégia', 'Analiso o mercado na sua zona, imóveis comparáveis e o perfil de comprador mais provável. Definimos o posicionamento e o preço de entrada.'],
  ['Preparação e entrada no mercado', 'Preparamos o imóvel para ser apresentado da melhor forma: fotografia profissional, materiais de divulgação e lançamento nos principais canais.'],
  ['Gestão de visitas e negociação', 'Organizo as visitas, qualifico os interessados e conduzo as negociações para garantir as melhores condições para si.'],
  ['Proposta aceite e escritura', 'Acompanho todo o processo até à escritura, tratando das etapas necessárias para que a venda decorra com segurança e tranquilidade.'],
];
const sold = [
  ['/assets/sold-carvicais.webp', 'Moradia T3 térrea, Isolada com 331m2 de terreno em Carviçais', 'Carviçais', 'Torre de Moncorvo'],
  ['/assets/sold-pacos.webp', 'Armazém à venda em Paços de Brandão', 'Paços de Brandão', 'Santa Maria a Feira'],
  ['/assets/sold-pedroso.webp', 'Moradia T2 para Recuperar em Pedroso e terreno 1.072 m² com viabilidade construtiva', 'Pedroso', 'Vila Nova de Gaia'],
  ['/assets/sold-vilar.webp', 'Apartamento T1+1 com elevador e garagem em Vilar do Paraíso', 'Vilar do Paraíso', 'Vila Nova de Gaia'],
  ['/assets/sold-serzedo.webp', 'Moradia Térrea T2 em Serzedo com Potencial de ser T3 e Anexo T1 Independente', 'Serzedo', 'Vila Nova de Gaia'],
];
const orderedTestimonials = testimonialOrder.routes.find(route => route.preListingLegacyId === record.legacyId)?.testimonials;
if (!orderedTestimonials) throw new Error('Missing verified public pre-listing testimonial order.');
const testimonials = orderedTestimonials.map(entry => {
  const own = sampleRecords.find(item => item._type === 'testimonial' && entry.candidateLegacyIds.includes(item.legacyId));
  const fallback = testimonialSource.testimonials.find(item => entry.candidateLegacyIds.includes(item.legacyId));
  if (!own && !fallback) throw new Error('Missing eligible pre-listing testimonial content.');
  return own ?? fallback;
});
---

<BaseLayout title={`Como vender a sua casa com sucesso ${record.clientName}`} socialImage={heroSocialImage ?? ''}>
  <main class="prelisting-page">
    <section class="prelisting-hero">
      {record.heroImage ? <CmsImage value={record.heroImage} alt="" loading="eager" /> : <img src="/assets/prelisting-hero-4725.jpg" alt="" loading="eager" />}
      <div class="prelisting-hero__shade"></div>
      <div class="prelisting-brand"><img src="/assets/logo-white.svg" alt="" /></div>
      <div class="prelisting-hero__inner"><div class="prelisting-hero__agent"><img src="/assets/prelisting-profile.png" alt="" /><span>JOAQUIM MOTA</span></div>
      <div class="prelisting-hero__copy"><h1>Conheça a estratégia de venda do seu imóvel.</h1><span class="prelisting-hero__divider"></span><div class="prelisting-hero__address"><strong>{record.clientName}</strong><span>{record.address}</span><div><span>{record.parish}</span><span>{record.municipality}</span></div></div></div></div>
      <div class="prelisting-hero__scroll">DESLIZE PARA BAIXO<span></span></div>
    </section>
    <section class="prelisting-section prelisting-section--intro"><div class="prelisting-person"><img src="/assets/prelisting-profile.png" alt="" /><p>Porquê comigo</p></div><h2>Vender o seu imóvel merece a dedicação certa.</h2><div class="prelisting-reasons">{reasons.map(([icon, title, copy]) => <article><img class="prelisting-icon" src={icon} alt="" /><h4>{title}</h4><p>{copy}</p></article>)}</div></section>
    <section class="prelisting-sold"><div class="prelisting-sold__heading"><p>Os meus resultados</p><h2>Últimos imóveis vendidos</h2></div><div class="prelisting-sold__rail">{[...sold, ...sold].map(([image, title, city, parish], index) => <article aria-hidden={index >= sold.length ? 'true' : undefined}><div><img src={image} alt="" /><span class="prelisting-sold__shade"></span><img class="prelisting-sold__banner" src="/assets/prelisting-sold-banner.webp" alt="" /><div class="prelisting-sold__copy"><h4>{title}</h4><span class="prelisting-sold__divider"></span><div class="prelisting-sold__locations">{parish && <h6 class:list={['prelisting-sold__municipality', {'prelisting-sold__municipality--mobile-hidden': index % sold.length >= 2, 'prelisting-sold__municipality--clone-hidden': index >= sold.length && index % sold.length >= 2}]}>{parish}</h6>}<h6 class="prelisting-sold__parish">{city}</h6></div></div></div></article>)}</div></section>
    <section class="prelisting-section prelisting-section--process"><p class="prelisting-kicker">O processo</p><h2>Simples, claro e orientado para um objetivo: vender bem o seu imóvel.</h2><ol>{process.map(([title, copy], index) => <li><span class="prelisting-process__icon"><img src={`/assets/prelisting-process-${index + 1}.svg`} alt="" /></span><div><h4>{title}</h4><p>{copy}</p></div></li>)}</ol></section>
    <section class="prelisting-stats"><p class="prelisting-stats__kicker">Os nossos resultados</p><h2>Vendemos a sua casa com sucesso.</h2><div><p>+ Valor<strong>96%</strong><span>Valor Inicial de Oferta</span></p><p>+ Rápido<strong>60 dias</strong><span>Tempo médio de venda</span></p><p>+ Tranquilidade<strong>85%</strong><span>Angariações Vendidas</span></p></div></section>
    <section class="prelisting-testimonials" id="testemunhos"><header><p>O que dizem os nossos clientes</p><h2>Os nossos clientes são os nossos maiores fãs.</h2><a href="/reviews">Leia as nossas avaliações</a></header><div>{testimonials.map(testimonial => <figure><div class="prelisting-stars" aria-label="5 estrelas">{Array.from({length:5},()=> <img src="/assets/prelisting-star.svg" alt="" />)}</div><blockquote>{testimonial.quote}</blockquote><figcaption><span class="prelisting-testimonial__avatar">{testimonial.portrait ? <CmsImage value={testimonial.portrait} alt="" /> : testimonial.portraitURL && <img src={testimonial.legacyId === '64d73faf12672d652ab57849' ? '/assets/testimonial-ivo.webp' : testimonial.portraitURL} alt="" />}</span><span>{testimonial.clientName}</span></figcaption></figure>)}</div></section>
    <section class="prelisting-contact"><div class="prelisting-contact__card" data-source-cta><div><p class="prelisting-contact__kicker">Próximo passo</p><div class="prelisting-contact__title"><h2>{record.clientName}</h2><h2>estou aqui para si.</h2></div><p>Sem compromisso. Sem pressão.</p></div><div class="prelisting-contact__portrait"><img src="/assets/prelisting-profile.png" alt="" /></div></div></section>
  </main>
  <Footer newsletter={false} facebookHref="https://www.facebook.com/joaquimmotakw" />
</BaseLayout>

<script>
  import { bindSourceScrollMotion, bindTestimonialMotion, interpolate } from '../../scripts/source-scroll-motion';
  const soldRail = document.querySelector('.prelisting-sold__rail');
  if (soldRail) {
    const observer = new IntersectionObserver(entries => {
      if (entries.some(entry => entry.isIntersecting)) {
        soldRail.classList.add('is-visible');
        observer.disconnect();
      }
    });
    observer.observe(soldRail);
  }
  document.querySelectorAll<HTMLElement>('[data-source-cta]').forEach(element => {
    bindSourceScrollMotion(element, (progress, reduced) => {
      element.style.opacity = reduced ? '1' : String(interpolate(progress, [[0,0],[.35,1]]));
      element.style.transform = reduced ? 'none' : `scale(${interpolate(progress, [[0,1.25],[.35,1]])})`;
    });
  });
  document.querySelectorAll<HTMLElement>('.prelisting-testimonials figure').forEach(bindTestimonialMotion);
</script>
