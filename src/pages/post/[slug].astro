---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { videoEmbedSource } from '../../lib/media-source';
import CmsGallery from '../../components/CmsGallery.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import Footer from '../../components/Footer.astro';
import CmsImage from '../../components/CmsImage.astro';
import CmsNewsletter from '../../components/CmsNewsletter.astro';
import Header from '../../components/Header.astro';
import CmsRichContent from '../../components/CmsRichContent.astro';
import sampleContent from '../../data/sample-content.json';
import '../../styles/cms.css';
import '../../styles/article.css';
export function getStaticPaths() { const sampleRecords: any[] = Array.isArray(sampleContent) ? sampleContent : (sampleContent as any).documents ?? []; return sampleRecords.filter((record) => record._type === 'article').map((record) => ({ params: { slug: record.slug?.current ?? record.sourceSlug }, props: { record } })); }
const { record } = Astro.props;
const videoSource = videoEmbedSource(record.videoUrl);
// The public Webflow template renders the source item's createdOn date.
const sourceDate = record.publishedAt ? new Date(record.publishedAt) : undefined;
const publishedAt = sourceDate ? `${sourceDate.getUTCDate()}/${sourceDate.getUTCMonth() + 1}/${sourceDate.getUTCFullYear()}` : undefined;
const imageRef = (record.openGraphImage ?? record.mainImage)?.asset?._ref;
const socialImage = typeof imageRef === 'string' ? (() => { const [, id, dimensions, format] = imageRef.match(/^image-(.+)-(\d+x\d+)-([a-z0-9]+)$/) ?? []; return id && dimensions && format ? `https://cdn.sanity.io/images/kaq1vd9b/production/${id}-${dimensions}.${format}` : undefined; })() : undefined;
---

<BaseLayout title={record.title} description="" socialImage={socialImage} richSocial>
  <Header variant="light" pageNavigation contactHref="/vamos-comecar" desktopContactHref="/vamos-comecar" />
  <main class="cms-article">
    <header class="cms-article__header">
      <div class="cms-article__meta"><a class="cms-article__category" href="#">Categoria</a>{record.readingMinutes && <span>Tempo de leitura: {record.readingMinutes} min</span>}</div>
      <h1>{record.title}</h1>{record.subtitle && <h4>{record.subtitle}</h4>}
    </header>
    <CmsImage value={record.mainImage} alt="" class="cms-article__hero" loading="eager" />
    <div class="cms-article__byline"><div><p>Autor</p><strong>Joaquim Mota</strong></div>{publishedAt && <div><p>Publicado em</p><strong>{publishedAt}</strong></div>}</div>
    <div class="cms-article__content">
      <article class="cms-article__body"><CmsRichContent blocks={record.body} />{videoSource && <iframe class="cms-media" title="Vídeo" src={videoSource} allowfullscreen />}<CmsGallery images={record.gallery} label="Galeria" /></article>
      <CmsNewsletter />
    </div>
    {record.cta?.heading && <ClosingCta eyebrow={record.cta.eyebrow} heading={record.cta.heading} body={record.cta.copy} label={record.cta.label} href={record.cta.href ?? '/vamos-comecar'} showButton={Boolean(record.cta.label)} />}
  </main>
  <Footer />
</BaseLayout>
