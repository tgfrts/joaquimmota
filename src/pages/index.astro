---
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/home-fidelity.css';
import content from '../data/sample-content.json';
import homeSource from '../data/home-process-source.json';
import SoldPropertiesSection from '../components/SoldPropertiesSection.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { ownRecordByLegacyId, recordsFromContent } from '../data/cms-content';
const homeIds = ['64d73faf12672d652ab57816', '64d73faf12672d652ab57825', '64d73faf12672d652ab57821'];
const records = recordsFromContent(content);
const ownHome = records.filter(record => record._type === 'processStep' && record.placement === 'home');
// Verified source copy keeps the preview intact until the approved bulk snapshot is materialized.
const homeSteps = homeIds.map(id => ownHome.find(record => record.legacyId === id) ?? homeSource.find(record => record.legacyId === id));
if (homeSteps.some(step => !step)) throw new Error('Missing Home process content.');

const testimonialFallback = [
  ['67b454c242cd3da4d37b19e1', 'Consultor de confiança, ajudou bastante no nosso processo e ficamos super satisfeitos.', 'Bruno Santos'],
  ['652f959cc8e4c50b1b987165', 'Gostaríamos de agradecer, a todos os intervenientes na compra do nosso imóvel, em especial ao Sr. Joaquim Mota e à D. Carla , que sempre nos aconselharam e tiverem imensa paciência durante todo o processo.\nHoje temos o nosso imóvel e apesar de muitas adversidades que ocorreram durante o processo, foram todos muito eficientes e profissionais connosco. O nosso muito obrigada!', 'Juliana Ramalho'],
  ['67b454c4b3a8ed624a80ab95', 'Muito bom resultados 100%. Excelente.', 'Joaquim Ferreira'],
  ['67b454c4445a686a6fdc2d56', 'Uma excelente pessoa. Um excelente vendedor. Felicidades.', 'Paulo Pereira'],
  ['67b454c31c58cf1ccb931413', 'Conseguiu rapidamente resolver a venda e compra da minha nova casa. Obrigada e felicidades.', 'Cristina Pinto'],
  ['67b454c4ba76a8566c116ae4', 'Recomendado. Profissionais merecedores de 5 estrelas.', 'Carla Rocha'],
  ['67b454c5e23698381d4b5a8b', 'Excelente profissional.', 'João Carlos de Almeida'],
  ['64d73faf12672d652ab5784a', 'O Sr. Joaquim foi super prestativo. Ajudou-nos completamente em todo o processo, foi super tranquilo. Graças à sua estratégia, a casa foi vendida em menos de uma semana. Muito obrigado.', 'Vera Silva'],
  ['652f95ea488ed3e20371204e', 'Vender e comprar casa ao mesmo tempo não é de todo fácil, mas com a ajuda do Sr. Joaquim Mota tornou-se possível. Sem dúvida um profissional de excelência. Dedicado e sempre pronto a ajudar. Sem a ajuda do sr. Joaquim nunca teria sido possível a nossa mudança de casa. Muito obrigada por tudo.', 'Susana Loureiro'],
  ['652f964e99e5a384fac6f29e', 'Desde já agradeço ao Sr. Joaquim Mota pela atenção dispensada e sempre que foi preciso a sua disponibilidade em dar, resposta as minhas necessidades! Continue sempre assim, um excelente profissional. Já não é o primeiro negócio que já realizamos. Acima de tudo muito honesto no que vê e no que prevê! Parabéns mais uma vez, obrigado por tudo. Assim haja muitos Srs. Joaquim.', 'João'],
] as const;
const testimonials = testimonialFallback.map(([legacyId, quote, clientName]) => ownRecordByLegacyId(records, 'testimonial', legacyId) ?? { legacyId, quote, clientName });

---

<BaseLayout description="Uma venda com sucesso" richSocial>
  <main class="home-page">
    <section class="hero">
      <video class="hero-video" autoplay muted loop playsinline poster="/assets/hero-poster.jpg" aria-hidden="true"><source src="/assets/hero.mp4" type="video/mp4" /></video><div class="hero-shade"></div><Header />
      <div class="hero-content shell"><p class="eyebrow">JOAQUIM MOTA CONSULTORES</p><h1>Uma experiência imobiliária bem sucedida</h1><p>Quer esteja a pensar vender ou comprar, estamos aqui para lhe guiar numa experiência bem sucedida.</p><div class="hero-actions"><a href="/vender" class="button button--light">Vou vender</a><a href="/comprar" class="button button--outline">Vou comprar</a></div></div>
    </section>

    <div class="home-secondary-header"><Header variant="blue" pageNavigation contactHref="/vamos-comecar" contactLabel="Vamos começar" showBlog={false} /></div>
    <section class="home-process shell"><div class="home-process__intro"><p class="eyebrow">Como o fazemos</p><h2>Espere mais do seu consultor</h2><p>Sabemos que vender e comprar uma casa pode ser complicado.<br />Estamos aqui para tornar esse processo o mais simples possível para si.</p></div><div class="home-process__steps">{homeSteps.map(step => <article data-source-id={step!.legacyId}><h3>{step!.title}</h3><p>{step!.body}</p></article>)}</div></section>
    <div class="home-results-background">
    <section class="results"><div class="shell section-grid"><div><p class="eyebrow">OS NOSSOS RESULTADOS</p><h2>Comercializamos a sua casa com excelência.</h2></div><div><p>A nossa estratégia de marketing é dinamicamente construída para obter os resultados que procura.<br />A nossa abordagem abrangente inclui anúncios direcionados no Facebook, email marketing, marketing de conteúdos e fotografias e videos profissionais. Criamos ainda uma página exclusiva no nosso site para a sua casa.</p></div></div><dl class="metrics shell"><div><dt>85%</dt><dd>Angariações vendidas</dd></div><div><dt>60 dias</dt><dd>Tempo médio de venda</dd></div><div><dt>-4%</dt><dd>Taxa média de desconto</dd></div></dl></section>
    <SoldPropertiesSection />
    </div>
    <section class="testimonials"><div class="shell testimonial-heading"><div><p class="eyebrow">O QUE DIZEM OS NOSSOS CLIENTES</p><h2>Os nossos clientes são os nossos maiores fãs.</h2></div><a href="/reviews" class="text-link">Leia as nossas avaliações</a></div><div class="testimonial-rail shell">{testimonials.map((testimonial) => <article class="testimonial-card"><div aria-label="5 estrelas" class="stars">{Array.from({ length: 5 }, () => <img src="/assets/prelisting-star.svg" alt="" loading="lazy" />)}</div><blockquote>{testimonial.quote}</blockquote><figcaption>{testimonial.clientName}</figcaption></article>)}</div></section>
    <ClosingCta heading="Ainda à procura de uma solução para a sua casa?" body="Tenha uma equipa de sucesso ao seu lado." href="/vamos-comecar" />
  </main>
  <Footer /><WhatsAppWidget />
</BaseLayout>

<script>
  import { bindSourceScrollMotion, interpolate } from '../scripts/source-scroll-motion';

  document.querySelectorAll<HTMLElement>('.home-process__steps article').forEach((step) => {
    bindSourceScrollMotion(step, (progress, reduced) => {
      step.style.opacity = reduced ? '1' : String(interpolate(progress, [[0, .25], [.35, 1], [.65, 1], [1, .25]]));
    });
  });


</script>
