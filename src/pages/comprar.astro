---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import data from '../data/sample-content.json'; import '../styles/buy-sell-marketing.css';
const cms=data.documents.find((d:any)=>d._type==='processStep'&&d.legacyId==='64d73faf12672d652ab57824'); const research=data.documents.find((d:any)=>d._type==='processStep'&&d.legacyId==='64d73faf12672d652ab57819'); const steps=[['02.','Inicie a pesquisa',research?.body],['03.','Visitas','Agora é hora da parte divertida – comprar a casa dos seus sonhos! Após selecionar algumas casas e agendar visitas, esta é a hora de visitar.'],['04.','Faça uma oferta','Depois de encontrar a sua casa preferida, é hora de fazer uma oferta. Isso pode parecer assustador, mas os nossos consultores irão guiar ao longo de todo o processo – espere algumas negociações aqui!'],['06.','Hora de festejar','Parabéns! Chegou a hora de fechar negócio da casa dos seus sonhos. Garantiremos que todos os documentos e transações necessárias sejam concluídos para lhe podermos entregar as chaves da sua nova casa!']];
---
<BaseLayout title="Comprar"><Header/><section class="bsm-hero"><span class="bsm-tag">Compradores</span><h1>Todos queremos ter uma casa de sonho</h1><p>Simplificamos o processo para que possa encontrar e comprar a sua casa de uma forma tranquila.</p><a class="bsm-button" href="#imoveis">Conheça os nosso imóveis</a></section><section class="bsm-section"><span class="bsm-tag">Uma compra tranquila</span><h2>Como funciona</h2><p>Sabemos que encontrar e comprar a casa ideal pode ser complicado. Estamos aqui para tornar esse processo o mais simples possível para si.</p><div class="bsm-steps">{cms&&<article class="bsm-step"><b>01.</b><h3>Obtenha a pré-aprovação</h3><p>{cms.body}</p><a href="/credito-habitacao">Quero obter uma proposta</a></article>}{steps.map(([n,t,p],index)=><article class="bsm-step"><b>{n}</b><h3>{t}</h3><p>{p}</p>{index===0&&<a href="/comprar#imoveis">{research?.ctaLabel}</a>}</article>)}</div></section><section id="imoveis" class="bsm-section bsm-dark"><h2>Imóveis</h2><p>Descubra aqui a sua casa de sonho</p><a class="bsm-button" href="/imoveis/kwpt036155">Ver imóveis</a></section><section class="bsm-cta"><h2>Quer comprar a sua casa com sucesso?</h2><p>Mais de 100 famílias compraram a sua casa connosco.</p><a class="bsm-button" href="/vamos-comecar">Vamos Começar</a></section><Footer/></BaseLayout>
