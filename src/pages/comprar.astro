---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import data from '../data/sample-content.json'; import '../styles/buy-sell-marketing.css';
import buySource from '../data/buy-process-source.json';
import '../styles/home-fidelity.css';
import '../styles/buy-fidelity.css';
const records: any[] = Array.isArray(data) ? data : (data as any).documents ?? [];
const buySteps = buySource.map(source => records.find(record => record._type === 'processStep' && record.placement === 'buy' && record.legacyId === source.legacyId) ?? source);

---
<BaseLayout title="Comprar"><Header variant="light" pageNavigation/><section class="buy-hero"><div class="buy-hero__heading"><span class="buy-hero__eyebrow">Compradores</span><h1>Todos queremos ter uma casa de sonho</h1><p>Simplificamos o processo para que possa encontrar e comprar a sua casa de uma forma tranquila.</p><a class="button" href="#imoveis">Conheça os nosso imóveis</a></div><div class="buy-hero__image-wrap"><img src="/assets/buy-kitchen.jpg" alt="" class="buy-hero__image" loading="eager" /><div class="buy-hero__image-overlay"></div></div></section><div class="home-secondary-header"><Header variant="light" pageNavigation contactHref="/vamos-comecar" contactLabel="Vamos começar" showBlog={false} /></div><section class="home-process shell"><div class="home-process__intro"><p class="eyebrow">Uma compra tranquila</p><h2>Como funciona</h2><p>Sabemos que encontrar e comprar a casa ideal pode ser complicado.<br /><br />Estamos aqui para tornar esse processo o mais simples possível para si.</p></div><div class="home-process__steps">{buySteps.map(step => <article data-source-id={step.legacyId}><h3>{step.title}</h3><p>{step.body}</p>{step.ctaLabel && step.ctaUrl && <a href={step.ctaUrl}>{step.ctaLabel}</a>}</article>)}</div></section><section id="imoveis" class="bsm-section bsm-dark"><h2>Imóveis</h2><p>Descubra aqui a sua casa de sonho</p><a class="bsm-button" href="/imoveis/kwpt036155">Ver imóveis</a></section><section class="bsm-cta"><h2>Quer comprar a sua casa com sucesso?</h2><p>Mais de 100 famílias compraram a sua casa connosco.</p><a class="bsm-button" href="/vamos-comecar">Vamos Começar</a></section><Footer/></BaseLayout>

<script>
  import { bindInteriorHero } from '../scripts/source-scroll-motion';
  const image = document.querySelector<HTMLImageElement>('.buy-hero__image');
  if (image) bindInteriorHero(image, document.querySelector<HTMLElement>('.buy-hero__image-overlay'));
</script>
