---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SoldPropertyRail from '../components/SoldPropertyRail.astro';
import ClosingCta from '../components/ClosingCta.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import { marketingTestimonials } from '../data/source-seller';
import '../styles/sell-fidelity.css';
import '../styles/marketing-fidelity.css';
---

<BaseLayout title="Marketing">
  <Header variant="light" pageNavigation />
  <main class="seller-page marketing-page">
    <section class="seller-hero"><div class="seller-hero__content"><p class="seller-kicker">Marketing</p><h1>MAIS EXPOSIÇÃO, MAIS OPORTUNIDADES</h1><p>Sabemos que a maioria dos consultores faz o mínimo necessário, por isso, resolvemos o problema: só oferecemos um serviço de qualidade máxima.</p><a class="seller-button" href="/reviews">As nossas avaliações</a></div><div class="seller-hero__image"><span class="seller-hero__overlay"></span><img src="/assets/marketing-hero.png" alt="" loading="eager" /></div></section>
    <div class="interior-secondary-header"><Header variant="blue" pageNavigation showBlog={false} contactHref="/vamos-comecar" contactLabel="Vamos começar" /></div>
    <section class="marketing-services"><div class="marketing-services__intro"><p class="seller-kicker">A magia do marketing</p><h2>A sua casa merece a melhor divulgação</h2><p><br />Uma boa estratégia de marketing faz com que a sua casa se destaque das outras casas no mercado.<br /><br />O nosso objetivo é fornecer estratégias inovadoras de marketing digital para garantir que a sua casa brilhe, para que os compradores certos a encontrem e a venham visitar.</p></div></section>
    <section class="seller-rail"><div class="seller-shell"><p class="seller-kicker">Um Marketing que funciona</p><h2>Últimos imóveis vendidos</h2><SoldPropertyRail /></div></section>
    <section class="seller-testimonials"><div class="seller-testimonials__head"><div><p class="seller-kicker">O que dizem os nossos clientes</p><h2>Os nossos clientes são os nossos maiores fãs.</h2></div><a class="seller-button" href="https://www.facebook.com/PauloSoaresRealEstateTeam/reviews" target="_blank" rel="noopener noreferrer">Leia as nossas avaliações no Facebook</a></div><div class="seller-testimonials__grid">{marketingTestimonials.map(({ name, quote }) => <figure><div class="marketing-stars" aria-label="5 estrelas">{Array.from({ length: 5 }, () => <svg viewBox="0 0 18 17" aria-hidden="true"><path d="M8.164.551a.91.91 0 0 1 1.672 0l1.826 4.337 4.739.375a.91.91 0 0 1 .517 1.572l-3.611 3.055 1.104 4.569a.91.91 0 0 1-1.353.971L9 14.418l-4.058 2.448a.91.91 0 0 1-1.353-.971l1.104-4.569L1.082 8.27A.91.91 0 0 1 1.6 6.698l4.739-.375z" /></svg>)}</div><blockquote>{quote}</blockquote><figcaption>{name}</figcaption></figure>)}</div></section>
    <ClosingCta heading="Ainda não tem um plano para a sua casa?" body="Temos a estratégia certa para si." href="/sessao-gratuita" />
  </main>
  <Footer />
  <WhatsAppWidget />
</BaseLayout>

<script>
  import { bindInteriorHero, bindTestimonialMotion } from '../scripts/source-scroll-motion';
  const heroImage = document.querySelector<HTMLImageElement>('.seller-hero__image img');
  if (heroImage) bindInteriorHero(heroImage, document.querySelector<HTMLElement>('.seller-hero__overlay'));
  document.querySelectorAll<HTMLElement>('.marketing-page .seller-testimonials figure').forEach(bindTestimonialMotion);
</script>
