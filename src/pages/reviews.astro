---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import ClosingCta from '../components/ClosingCta.astro';
import sampleContent from '../data/sample-content.json';
import '../styles/reviews-fidelity.css';
import { ownRecordByLegacyId, recordsFromContent } from '../data/cms-content';

const records = recordsFromContent(sampleContent);
const sourceReviews = [
  ['67b454c5e23698381d4b5a8b', 'João Carlos de Almeida', 'Excelente profissional.'],
  ['64d73faf12672d652ab5784c', 'Bruno Oliveira', 'Quero-lhe agradecer a amabilidade e profissionalismo com que tratou da venda da minha casa.\nFicou com mais um amigo. Muito sucesso e quando voltar a comprar casa certamente será consigo. Muito obrigado e um abraço!'],
  ['67b454c40e6191ab38dd93b4', 'sonia teixeira', 'Muita eficácia e profissionalismo... Recomendo.'],
  ['64d73faf12672d652ab5784a', 'Vera Silva', 'O Sr. Joaquim foi super prestativo. Ajudou-nos completamente em todo o processo, foi super tranquilo. Graças à sua estratégia, a casa foi vendida em menos de uma semana. Muito obrigado.'],
  ['67b454c5e23698381d4b5a8b', 'João Carlos de Almeida', 'Excelente profissional.'],
  ['67b454c4445a686a6fdc2d56', 'Paulo Pereira', 'Uma excelente pessoa. Um excelente vendedor. Felicidades.'],
  ['67b454c48728d3d81a387c44', 'Carlos Dourado', 'Registo, o profissionalismo do Sr. Joaquim Mota, durante o período que ambos partilhamos, o que permitiu a consumação do contrato relativo ao apartamento, sito em Macedo de Cavaleiros.'],
  ['67b454c3e4e0b333d8cfef31', 'Ivone Baldaia', 'Consultoria imobiliária de excelência, apoio em todo o processo de compra e pós compra. Obrigada Sr. Mota pelo profissionalismo, seriedade e disponibilidade.'],
  ['67b454c242cd3da4d37b19e1', 'Bruno Santos', 'Consultor de confiança, ajudou bastante no nosso processo e ficamos super satisfeitos.'],
  ['652f96102bab7444d6e36fe0', 'Bruna Augusto', 'Excelente profissional muito acessível e simpático gosta do que faz e prima por ser uma pessoa genuína .Obrigado por tudo.'],
] as const;
const reviews = sourceReviews.map(([legacyId, clientName, quote]) => ownRecordByLegacyId(records, 'testimonial', legacyId) ?? { legacyId, clientName, quote });
const googleReviews = 'https://www.google.com/search?sca_esv=8a5f3c529fc99551&hl=pt-PT&si=APYL9bs7Hg2KMLB-4tSoTdxuOx8BdRvHbByC_AuVpNyh0x2KzQv_LngknV97AguR9DyJ43ug8lKUScEz-IEp4X8FWpBof3OgPOsehMBCKn3ExCty8hLMA5jgyjsLIyNImebmOGDUMhaZB2CFwGV7BXhRlsr2xuBklqJNyX9vRfua0_H5kBtLA5k%3D&q=JRM+Joaquim+Mota+Consultor+Imobili%C3%A1rio+Cr%C3%ADticas&sa=X&ved=2ahUKEwj0j6XMvtKLAxXzcaQEHYLUHoMQ0bkNegQILBAE&biw=1420&bih=855&dpr=2';
---
<BaseLayout title="Reviews">
  <Header variant="light" pageNavigation contactHref="/contacto" />
  <main class="reviews-fidelity">
    <header class="reviews-fidelity__hero"><div><p>Porquê trabalhar connosco</p><h1>Somos alimentados pelo seu sucesso</h1><p>Dedicamo-nos para entregar um serviço de primeira classe para os nossos clientes. Se ainda não o deixamos claro, esperamos que estas avaliações ajudem a comprovar o nosso compromisso.</p><a href="/reviews">O que dizem os nossos clientes</a></div><div class="reviews-fidelity__hero-image"><span class="reviews-fidelity__hero-overlay"></span><img src="/assets/reviews-hero.png" alt="" loading="eager" /></div></header>
    <div class="interior-secondary-header"><Header variant="blue" pageNavigation showBlog={false} contactHref="/vamos-comecar" contactLabel="Vamos começar" /></div>
    <section class="reviews-fidelity__testimonials"><header><div><p>O que dizem os nossos clientes</p><h2>Os nossos clientes são os nossos maiores fãs.</h2></div><a href={googleReviews} target="_blank" rel="noopener noreferrer">Leia as nossas avaliações no Google</a></header><div class="reviews-fidelity__grid">{reviews.map((review) => <figure><div class="reviews-fidelity__stars" aria-label="5 estrelas">{Array.from({ length: 5 }, () => <svg viewBox="0 0 18 17" aria-hidden="true"><path d="M8.164.551a.91.91 0 0 1 1.672 0l1.826 4.337 4.739.375a.91.91 0 0 1 .517 1.572l-3.611 3.055 1.104 4.569a.91.91 0 0 1-1.353.971L9 14.418l-4.058 2.448a.91.91 0 0 1-1.353-.971l1.104-4.569L1.082 8.27A.91.91 0 0 1 1.6 6.698l4.739-.375z" /></svg>)}</div><blockquote>{review.quote}</blockquote><figcaption>{review.clientName}</figcaption></figure>)}</div></section>
    <ClosingCta heading="Ainda à procura de uma parceria de confiança?" body="Na opinião dos nossos clientes somos a melhor opção." href="/vamos-comecar" />
  </main><Footer /><WhatsAppWidget />
<script>
  import { bindInteriorHero } from '../scripts/source-scroll-motion';
  const image = document.querySelector<HTMLImageElement>('.reviews-fidelity__hero-image img');
  if (image) bindInteriorHero(image, document.querySelector<HTMLElement>('.reviews-fidelity__hero-overlay'));
</script>
</BaseLayout>
