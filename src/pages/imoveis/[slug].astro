---
import SiteIcon from '../../components/SiteIcon.astro';
import { mediaSource, videoEmbedSource } from '../../lib/media-source';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { hasPropertyCharacteristic } from '../../lib/property-characteristics';
import { formatPropertyPrice } from '../../lib/format-property-price';
import CmsGallery from '../../components/CmsGallery.astro';
import CmsMap from '../../components/CmsMap.astro';
import CmsRichContent from '../../components/CmsRichContent.astro';
import CmsImage from '../../components/CmsImage.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import CmsPropertyInquiry from '../../components/CmsPropertyInquiry.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import sampleContent from '../../data/sample-content.json';
import '../../styles/cms.css';
import '../../styles/property.css';

export function getStaticPaths() { const sampleRecords: any[] = Array.isArray(sampleContent) ? sampleContent : (sampleContent as any).documents ?? []; return sampleRecords.filter((record) => record._type === 'property').map((record) => ({ params: { slug: record.slug?.current ?? record.sourceSlug }, props: { record } })); }
const { record } = Astro.props;
const gallery = record.gallery ?? [];
const imageRef = record.featuredImage?.asset?._ref;
const socialImage = typeof imageRef === 'string' ? (() => { const [, id, dimensions, format] = imageRef.match(/^image-(.+)-(\d+x\d+)-([a-z0-9]+)$/) ?? []; return id && dimensions && format ? `https://cdn.sanity.io/images/kaq1vd9b/production/${id}-${dimensions}.${format}` : undefined; })() : undefined;
const amenityLabels = { elevator: ['Elevador', 'lift'], storage: ['Arrecadação', 'warehouse'], balcony: ['Varanda', 'balcony'], terrace: ['Terraço', 'fence'], garden: ['Jardim', 'trees'], pool: ['Piscina', 'waves'] };
const amenities = Object.entries(amenityLabels).filter(([key]) => record.amenities?.[key]).map(([, [label, icon]]) => ({ label, icon }));
const mapSource = mediaSource(record.mapEmbed);
const videoSource = videoEmbedSource(record.videoUrl);
const tourSource = mediaSource(record.matterportUrl);
---

<BaseLayout title={record.title} description="" socialImage={socialImage ?? ''} richSocial>
  {mapSource && <Fragment slot="head"><link rel="preconnect" href="https://www.google.com" /><link rel="preconnect" href="https://maps.gstatic.com" crossorigin /></Fragment>}
  <Header variant="light" pageNavigation contactHref="/contacto" desktopContactHref="/vamos-comecar" />
  <main class:list={['property-page', { 'property-page--reserved': record.marketBanner === 'reserved' }]}><button type="button" class="property-page__cover-trigger" data-gallery-open="property-gallery" aria-label="Abrir imagem de capa na galeria" aria-controls="property-gallery-dialog" aria-haspopup="dialog"><CmsImage value={record.featuredImage} alt="" class="property-page__cover" loading="eager" /></button><div class="property-page__layout"><section class="property-page__header shell"><h1>{record.title}</h1><div class="property-page__summary">{record.marketBanner === 'reserved' && <div class="property-page__reserved">Reservado</div>}<div class="property-page__price">{record.priceOnRequest ? 'Preço sob consulta' : formatPropertyPrice(record.price)}</div><div class="property-page__location"><strong>{record.municipality}</strong><span>{record.parish}</span></div><p class="property-page__reference">ID: {record.referenceCode}</p><div class="property-page__facts">{hasPropertyCharacteristic(record.bedrooms) && <span aria-label={`${record.bedrooms} quartos`}><SiteIcon name="bed" size={17} />{record.bedrooms}</span>}{hasPropertyCharacteristic(record.bathrooms) && <span aria-label={`${record.bathrooms} casas de banho`}><SiteIcon name="bath" size={17} />{record.bathrooms}</span>}{hasPropertyCharacteristic(record.parkingSpaces) && <span class="property-page__parking" aria-label={`${record.parkingSpaces} lugares de estacionamento`}><SiteIcon name="garage" size={17} />{record.parkingSpaces}</span>}{hasPropertyCharacteristic(record.usableArea) && <span><SiteIcon name="area-useful" size={17} /><span>{record.usableArea}</span><span>&nbsp;m2 </span><span> - Área Útil</span></span>}{hasPropertyCharacteristic(record.grossArea) && <span><SiteIcon name="area" size={17} /><span>{record.grossArea}</span><span>&nbsp;m2</span><span> - Área Bruta</span></span>}{record.energyCertificate && <span class="property-page__certificate" aria-label={`Certificado energético ${record.energyCertificate}`}><span class="property-page__certificate-label--desktop">Certificado Energético</span><span class="property-page__certificate-label--mobile">CE</span>{record.energyCertificate}</span>}</div></div></section><section class="property-page__body shell"><article class="cms-copy property-page__card" id="descricao"><h2>Descrição</h2><CmsRichContent blocks={record.description} /></article><section class="property-page__card" id="galeria"><h2>Fotografias</h2><CmsGallery images={gallery} label="Fotografias" id="property-gallery" openingImage={record.featuredImage} preview /></section>{amenities.length > 0 && <section class="property-page__card property-page__characteristics" id="caracteristicas"><h2>Características</h2><ul>{amenities.map((amenity) => <li><SiteIcon name={amenity.icon} size={17} />{amenity.label}</li>)}</ul></section>}{mapSource && <section class="property-page__card" id="localizacao"><h2>Localização</h2><CmsMap embed={mapSource} title="Localização" loading="eager" /></section>}{videoSource && <section class="property-page__card"><h2>Video</h2><iframe class="cms-media" title="Vídeo" src={videoSource} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen /></section>}{tourSource && <section class="property-page__card"><h2>Faça uma visita virtual</h2><iframe class="cms-media" title="Visita virtual" src={tourSource} allowfullscreen /></section>}</section><aside class="property-page__inquiry shell"><CmsPropertyInquiry /></aside></div></main>
  <ClosingCta eyebrow="VAMOS CONVERSAR" heading="Ainda à procura da sua casa de sonho?" body="Nós podemos ajudar." href="/vamos-comecar" />
  <Footer />
</BaseLayout>

<script>
  import { bindSourceScrollMotion, interpolate } from '../../scripts/source-scroll-motion';
  const header = document.querySelector<HTMLElement>('.property-page__header');
  if (header) bindSourceScrollMotion(header, (progress, reduced) => {
    const opacity = reduced || innerWidth <= 991 ? '1' : String(interpolate(progress, [[.35, 0], [.65, 1]]));
    header.style.opacity = opacity;
  });


</script>
