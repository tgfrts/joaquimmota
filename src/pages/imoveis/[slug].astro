---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CmsGallery from '../../components/CmsGallery.astro';
import CmsMap from '../../components/CmsMap.astro';
import CmsRichContent from '../../components/CmsRichContent.astro';
import CmsImage from '../../components/CmsImage.astro';
import CmsPropertyInquiry from '../../components/CmsPropertyInquiry.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import sampleContent from '../../data/sample-content.json';
import '../../styles/cms.css';
import '../../styles/property.css';

export function getStaticPaths() { const sampleRecords: any[] = Array.isArray(sampleContent) ? sampleContent : (sampleContent as any).documents ?? []; return sampleRecords.filter((record) => record._type === 'property').map((record) => ({ params: { slug: record.slug?.current ?? record.sourceSlug }, props: { record } })); }
const { record } = Astro.props;
const gallery = record.gallery ?? [];
const imageRef = record.featuredImage?.asset?._ref;
const socialImage = typeof imageRef === 'string' ? (() => { const [, id, dimensions, format] = imageRef.match(/^image-(.+)-(\d+x\d+)-([a-z0-9]+)$/) ?? []; return id && dimensions && format ? `https://cdn.sanity.io/images/kaq1vd9b/production/${id}-${dimensions}.${format}` : undefined; })() : undefined;
const amenityLabels: Record<string, string> = { elevator: 'Elevador', storage: 'Arrecadação', balcony: 'Varanda', terrace: 'Terraço', garden: 'Jardim', pool: 'Piscina' };
const amenities = Object.entries(amenityLabels).filter(([key]) => record.amenities?.[key]).map(([, label]) => label);
---

<BaseLayout title={record.title} description="" socialImage={socialImage} richSocial>
  <Header variant="light" pageNavigation contactHref="/vamos-comecar" />
  <main class:list={['property-page', { 'property-page--reserved': record.marketBanner === 'reserved' }]}><CmsImage value={record.featuredImage} alt="" class="property-page__cover" loading="eager" /><section class="property-page__header shell"><h1>{record.title}</h1><div class="property-page__summary">{record.marketBanner === 'reserved' && <div class="property-page__reserved">Reservado</div>}<div class="property-page__price">{record.priceOnRequest ? 'Preço sob consulta' : <><span>€</span>{record.price}</>}</div><div class="property-page__location"><strong>{record.municipality}</strong><span>{record.parish}</span></div><p class="property-page__reference">ID: {record.referenceCode}</p><div class="property-page__facts">{record.bedrooms != null && <span aria-label={`${record.bedrooms} quartos`}><img src="/assets/property-bed.svg" alt="" />{record.bedrooms}</span>}{record.bathrooms != null && <span aria-label={`${record.bathrooms} casas de banho`}><img src="/assets/property-bath.svg" alt="" />{record.bathrooms}</span>}{record.parkingSpaces != null && <span class="property-page__parking" aria-label={`${record.parkingSpaces} lugares de estacionamento`}><img src="/assets/property-garage.svg" alt="" />{record.parkingSpaces}</span>}{record.usableArea != null && <span><img src="/assets/property-area.svg" alt="" /><span>{record.usableArea}</span><span>&nbsp;m2 </span><span> - Área Útil</span></span>}{record.grossArea != null && <span><img src="/assets/property-area.svg" alt="" /><span>{record.grossArea}</span><span>&nbsp;m2</span><span> - Área Bruta</span></span>}{record.energyCertificate && <span aria-label={`Certificado energético ${record.energyCertificate}`}>{record.energyCertificate}</span>}</div></div></section><section class="property-page__body shell"><article class="cms-copy property-page__card" id="descricao"><h2>Descrição</h2><CmsRichContent blocks={record.description} /></article>{amenities.length > 0 && <section class="property-page__card property-page__characteristics" id="caracteristicas"><h2>Características</h2><ul>{amenities.map((amenity) => <li><img src="/assets/property-check.svg" alt="" />{amenity}</li>)}</ul></section>}<section class="property-page__card" id="localizacao"><h2>Localização</h2><CmsMap embed={record.mapEmbed} title="Localização" /></section>{record.videoUrl && <section class="property-page__card"><h2>Video</h2><iframe class="cms-media" title="Vídeo" src={record.videoUrl} allowfullscreen /></section>}{record.matterportUrl && <section class="property-page__card"><h2>Faça uma visita virtual</h2><iframe class="cms-media" title="Visita virtual" src={record.matterportUrl} allowfullscreen /></section>}<section class="property-page__card" id="galeria"><h2>Galeria</h2><CmsGallery images={gallery} label="Galeria" /></section><section class="property-page__inquiry"><CmsPropertyInquiry /></section></section></main>
  <section class="property-closing"><div class="property-closing__card"><div><p>VAMOS CONVERSAR</p><h2>Ainda à procura da sua casa de sonho?</h2><p>Nós podemos ajudar.</p><a href="/vamos-comecar">Vamos Começar</a></div><div class="property-closing__portrait"><img src="/assets/prelisting-profile.png" alt="" loading="lazy" /></div></div></section>
  <Footer />
</BaseLayout>

<script>
  import { bindSourceScrollMotion, interpolate } from '../../scripts/source-scroll-motion';
  const header = document.querySelector<HTMLElement>('.property-page__header');
  if (header) bindSourceScrollMotion(header, (progress, reduced) => {
    header.style.opacity = reduced || innerWidth <= 767 ? '1' : String(interpolate(progress, [[.35, 0], [.65, 1]]));
  });
  const closing = document.querySelector<HTMLElement>('.property-closing__card');
  if (closing) bindSourceScrollMotion(closing, (progress, reduced) => {
    closing.style.transform = reduced ? 'none' : `scale(${interpolate(progress, [[0, 1.25], [.35, 1]])})`;
    closing.style.opacity = reduced ? '1' : String(interpolate(progress, [[0, 0], [.35, 1]]));
  });
</script>
