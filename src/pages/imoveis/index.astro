---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CmsImage from '../../components/CmsImage.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import PropertyGrid from '../../components/PropertyGrid.astro';
import PropertyFacts from '../../components/PropertyFacts.astro';
import PropertyNewsletter from '../../components/PropertyNewsletter.astro';
import BuySellGuide from '../../components/BuySellGuide.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import WhatsAppWidget from '../../components/WhatsAppWidget.astro';
import { featuredProperties } from '../../data/available-properties';
import { formatPropertyPrice } from '../../lib/format-property-price';
import '../../styles/buy-fidelity.css';
import '../../styles/blog-index.css';
---
<BaseLayout title="Imóveis" description="Descubra aqui a sua casa de sonho. Conheça os imóveis disponíveis de Joaquim Mota Consultores.">
  <Header variant="light" pageNavigation />
  <main class="blog-index property-directory">
    {featuredProperties.length > 0 && <section class="blog-index__featured" aria-label="Imóvel em destaque" data-featured-properties>
      {featuredProperties.map((featured, index) => <>
      <div class="blog-index__featured-card" data-featured-card hidden={index > 0}>
        <div class="property-featured__desktop"><div class="blog-index__featured-copy"><p class="property-featured__badge">Imóvel em destaque</p><h1 id={`property-featured-title-${index}`}>{featured.title}</h1><div class="property-featured__summary"><p class="buy-property__price">{featured.priceOnRequest ? 'Preço sob consulta' : formatPropertyPrice(featured.price)}</p><p class="buy-property__place"><span>{featured.municipality}</span><span>{featured.parish}</span></p><p class="buy-property__reference">{featured.reference}</p></div><a href={`/imoveis/${featured.slug}`}>Conheça este imóvel</a><hr class="property-featured__divider" /><PropertyFacts beds={featured.beds} baths={featured.baths} parking={featured.parking} area={featured.area} /></div>
        <div class="blog-index__featured-image">{featured.cms?.featuredImage ? <CmsImage value={featured.cms.featuredImage} alt="" loading={index === 0 ? 'eager' : 'lazy'} /> : <img src={featured.image} alt="" loading={index === 0 ? 'eager' : 'lazy'} />}</div></div><div class="property-featured__mobile"><PropertyCard property={featured} badge="Imóvel em destaque" headingTag="h1" /></div>
      </div>
      </>)}
    </section>}
    <PropertyNewsletter />
    <section class="property-directory__list" aria-label="Imóveis disponíveis"><div class="shell"><PropertyGrid limit={6} /></div></section>
    <BuySellGuide />
    <section class="property-directory__list" aria-label="Mais imóveis disponíveis"><div class="shell"><PropertyGrid offset={6} /></div></section>
    <ClosingCta heading="Quer comprar a sua casa com sucesso?" body="Mais de 100 famílias compraram a sua casa connosco." href="/vamos-comecar" />
  </main>
  <Footer />
  <WhatsAppWidget />
</BaseLayout>
<script>
  import { bindFeaturedProperties } from '../../scripts/featured-properties';
  document.querySelectorAll<HTMLElement>('[data-featured-properties]').forEach(section => bindFeaturedProperties(section));
</script>
<style>
  .property-featured__desktop{display:contents}
  .property-featured__mobile{display:none}
  .blog-index__featured-card[hidden]{display:none}
  .property-directory .blog-index__featured-image{aspect-ratio:3 / 2}
  .property-directory .blog-index__featured-copy h1{font-size:40px;line-height:48px;letter-spacing:-.8px}
  .property-featured__badge{display:inline-block;margin:0 0 16px;padding:8px 16px;background:#db1430;color:#fff;font:500 16px/24px Roboto,sans-serif}
  .property-directory .blog-index__featured-copy>a{background:transparent;color:#db1430;border-color:#db1430;box-shadow:none}
  .property-featured__summary{margin-top:24px}
  .property-featured__summary .buy-property__place{flex-wrap:wrap;row-gap:8px}
  .property-featured__divider{height:1px;border:0;background:#ddd;margin:32px 0}
  .property-directory__list{padding:64px 0}
  .property-directory__list .shell{width:90vw;max-width:none}
  .property-directory__list :global(.buy-properties__grid){margin-top:0}
  @media(max-width:991px){.property-directory__list{padding:5vw 0}}
  @media(max-width:767px){.property-directory .blog-index__featured{display:none}.property-featured__desktop{display:none}.property-featured__mobile{display:block;width:100%}.property-directory .blog-index__featured-card{display:block}.property-directory .blog-index__featured-card[hidden]{display:none}.property-directory .blog-index__featured-copy h1{font-size:32px;line-height:38.4px;letter-spacing:-.64px}}
</style>
