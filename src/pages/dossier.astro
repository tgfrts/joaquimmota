---
import BaseLayout from '../layouts/BaseLayout.astro'; import CampaignLeadForm from '../components/CampaignLeadForm.astro'; import '../styles/lead-magnets.css';
const download='https://drive.google.com/file/d/1wi6qHnQzGuJOpk2uK1WyfFUzRGUcAndF/view?usp=sharing';
---
<BaseLayout title="Dossier"><main class="lead-magnet"><div class="lead-magnet__image" style="background-image:url('/assets/campaign-dossier.jpg')"></div><section class="lead-magnet__panel"><a class="lead-magnet__logo" href="/"><img src="/assets/logo-color.svg" alt="Joaquim Mota Consultores" /></a><h5 class="lead-magnet__heading">Obtenha o seu Guia de Proprietário</h5><p class="lead-magnet__intro">Preencha o formulário e descubra como trabalhamos e obtemos o melhor resultado na venda da casa dos nossos clientes.</p><CampaignLeadForm route="/dossier" submitLabel="Descarregar" downloadUrl={download}><p class="lead-magnet__legal">©{new Date().getFullYear()} - Somos Real Estate, Med. Imo. Lda. AMI 11829. Cada Market Center da Keller Williams é de propriedade e gestão independente.</p></CampaignLeadForm></section></main></BaseLayout>
