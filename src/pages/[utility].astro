---
import SeoMetadata from '../components/SeoMetadata.astro';
import SiteIcons from '../components/SiteIcons.astro';
import '../styles/global.css';
import '../styles/not-found.css';

export function getStaticPaths() {
  return [{ params: { utility: '404' } }];
}
---

<!doctype html>
<html lang="pt-PT">
  <head><SiteIcons />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoMetadata noindex />
    <title>Página não encontrada | Joaquim Mota</title>
    <meta property="og:title" content="Página não encontrada | Joaquim Mota" />
    <meta name="twitter:title" content="Página não encontrada | Joaquim Mota" />
  </head>
  <body class="not-found">
    <header class="not-found-header">
      <a href="/" aria-label="Joaquim Mota — página inicial"><img src="/assets/logo-color.svg" width="100" height="49" alt="" /></a>
    </header>
    <main class="not-found-main" aria-labelledby="not-found-title">
      <div class="not-found-content">
        <h1 id="not-found-title">Página não encontrada</h1>
        <p>Não encontrámos a página que procura. Pode ter mudado de endereço ou já não estar disponível.</p>
        <div class="not-found-actions">
          <a class="not-found-button" href="/">Voltar ao início</a>
          <a class="not-found-button not-found-button--outline" href="/imoveis">Ver imóveis</a>
        </div>
        <a class="not-found-contact" href="/vamos-comecar">Falar com Joaquim Mota</a>
      </div>
    </main>
  </body>
</html>
