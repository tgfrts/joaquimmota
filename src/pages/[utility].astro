---
import SeoMetadata from '../components/SeoMetadata.astro';
import SiteIcons from '../components/SiteIcons.astro';
import '../styles/global.css';
import '../styles/utility-pages.css';

export function getStaticPaths() {
  return [{ params: { utility: '404' } }];
}
---

<!doctype html>
<html lang="pt-PT">
  <head><SiteIcons />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoMetadata noindex />
    <title>Not Found</title>
    <meta property="og:title" content="Not Found" />
    <meta name="twitter:title" content="Not Found" />
  </head>
  <body class="utility-page">
    <main class="utility-component" aria-labelledby="not-found-title">
      <section class="utility-card">
        <img class="utility-image" src="/assets/utility-page-not-found.svg" alt="" />
        <h3 id="not-found-title">Page Not Found</h3>
        <p>The page you are looking for doesn&#39;t exist or has been moved</p>
        <a class="utility-button" href="#">Go Home</a>
      </section>
    </main>
  </body>
</html>
