---
import BaseLayout from '../layouts/BaseLayout.astro';
import CampaignLeadForm from '../components/CampaignLeadForm.astro';
import '../styles/campaigns.css';
---
<BaseLayout title="Vamos começar"><main class="campaign-page campaign-page--contact"><div class="campaign-page__image" style="background-image:url('/assets/campaign-vamos.png')"></div><section class="campaign-page__panel"><a href="/"><img class="campaign-page__logo" src="/assets/logo-color.svg" alt="" /></a><h5>Estamos aqui para ajudar.</h5><p class="campaign-page__intro">Fale connosco e descubra como poderá iniciar a sua jornada<br class="contact-desktop-break"/> de compra ou venda da sua casa no grande Porto.</p><CampaignLeadForm route="/vamos-comecar" submitLabel="Enviar" formType="contact" contactSubject><p class="campaign-page__legal">©{new Date().getFullYear()} - Somos Real Estate, Med. Imo. Lda. AMI 11829. Cada Market Center da Keller Williams é de propriedade e gestão independente.</p></CampaignLeadForm></section></main></BaseLayout>
<style>.campaign-page--contact .campaign-page__intro{margin:0;font-size:16px;line-height:24px}.campaign-page--contact .campaign-page__legal{font-size:10px;line-height:15px}@media(max-width:767px){.contact-desktop-break{display:none}}</style>
