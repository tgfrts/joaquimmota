---
import SeoMetadata from '../components/SeoMetadata.astro';
import SiteIcons from '../components/SiteIcons.astro';
import inventory from '../../docs/migration/blank-template-routes.json';
export function getStaticPaths() {
  return inventory.routes.map(route => ({ params: { blank: route.path }, props: { title: route.title } }));
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="pt-PT"><head><SiteIcons /><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><SeoMetadata noindex /><title>{title}</title></head><body></body></html>
